#!/usr/bin/env python3
"""A stand-in for minipro in the T48 tests: no programmer, no chip. Driven by the environment:

    FAKE_ROM       the file a read returns (missing = the read fails)
    FAKE_PARTS     part names it "knows" (comma-separated; default a few 27C-series ones)
    FAKE_PIN       ok | unsupported | bad
    FAKE_ID        ok | mismatch (read fails with minipro's 2026-09-28 message unless -y)
    FAKE_FLAKY     1 = the second read differs in one byte
    FAKE_COUNTER   a file counting reads (for FAKE_FLAKY)
    FAKE_CHIP      a file standing for the chip in the socket (burn tests): reads return it, -b passes only when it's
                   all 0xFF, -w programs it (bits go 1 -> 0 only, like a UV EPROM) and verifies, as minipro 0.7.4 does
    FAKE_WRITE_FAIL 1 = the write leaves one byte unprogrammed (so minipro's verify fails)
    FAKE_SIZES     part=bytes pairs for -d (default: the 27C020s 262144, 27C010 131072)
Progress is printed with \\r and ESC[K like the real one, so the parser's clean-up is tested too. Messages are
minipro 0.7.4's own (src/main.c: "memory section is blank.", "Verification OK", "Verification failed at address").
"""
import os
import sys

a = sys.argv[1:]
parts = os.environ.get("FAKE_PARTS", "27C010@DIP32,27C020@DIP32,TMS27C020@DIP32,AM27C020@DIP32,27C1000@DIP32,"
                                     "TMS27C020@TSOP32,TMS27C020@PLCC32,OLD2716").split(",")
print("Found T48 00.1.32 (0x120)\nWarning: T48 support is not yet complete!", file=sys.stderr)


def opt(o):
    return a[a.index(o) + 1] if o in a else None


if "--version" in a:
    print("minipro version 0.7.4     A free and open TL866 series programmer")
    sys.exit(0)
if "-l" in a or "-L" in a:
    q = opt("-L")
    for p in parts:
        if q is None or q.lower() in p.lower():
            print(p)
    sys.exit(0)
SIZES = dict(x.split("=") for x in os.environ.get(
    "FAKE_SIZES", "27C020@DIP32=262144,TMS27C020@DIP32=262144,AM27C020@DIP32=262144,27C010@DIP32=131072,"
                  "27C1000@DIP32=131072,TMS27C020@TSOP32=262144,TMS27C020@PLCC32=262144,OLD2716=2048").split(","))
if "-d" in a:                                             # minipro -q T48 -d PART: the device's info
    dev = opt("-d")
    if dev not in parts:
        print(f"Device {dev} not found!", file=sys.stderr)
        sys.exit(1)
    print(f"Name: {dev}\nMemory: {SIZES.get(dev, '262144')} Bytes\nPackage: DIP32\n"
          "*******************************\nVPP programming voltage: 12.5V\nVDD write voltage: 6.5V")
    sys.exit(0)
part = opt("-p")
if part not in parts:
    print(f"Device {part} not found!", file=sys.stderr)
    sys.exit(1)
if "-z" in a:
    pin = os.environ.get("FAKE_PIN", "ok")
    if pin == "unsupported":
        print("Pin test is not supported.", file=sys.stderr)
        sys.exit(1)
    if pin == "bad":
        print("Bad contact on pin:12", file=sys.stderr)
        sys.exit(1)
    print("Pin test passed.", file=sys.stderr)
    sys.exit(0)
chip = os.environ.get("FAKE_CHIP")


def id_check():
    """The chip-ID check minipro does before a read, a blank check or a write (unless -y)."""
    if os.environ.get("FAKE_ID") == "mismatch" and "-y" not in a:
        print("Invalid Chip ID: expected 0x8934, got 0x9732 (TMS27C020@DIP32)", file=sys.stderr)
        sys.exit(1)


if "-b" in a and chip:                                    # blank check
    id_check()
    data = open(chip, "rb").read()
    bad = next((i for i, x in enumerate(data) if x != 0xFF), None)
    if bad is None:
        print("Code memory section is blank.", file=sys.stderr)
        sys.exit(0)
    print(f"Verification failed at address 0x{bad:04X}: File=0xFF, Device=0x{data[bad]:02X}", file=sys.stderr)
    sys.exit(1)
if "-w" in a and chip:                                    # write, then verify (no -v), like minipro 0.7.4
    id_check()
    src = open(opt("-w"), "rb").read()
    size = int(SIZES.get(part, "262144"))
    if len(src) != size and "-s" not in a:
        print(f"Incorrect file size: {len(src)} (needed {size}, use -s/S to ignore)", file=sys.stderr)
        sys.exit(1)
    old = open(chip, "rb").read()
    new = bytearray(o & s for o, s in zip(old, src))      # a UV EPROM: programming only clears bits
    if os.environ.get("FAKE_WRITE_FAIL") == "1":
        new[200] = old[200]
    for pct in (0, 50, 100):
        sys.stderr.write(f"\rWriting Code...  {pct}%\x1b[K")
    sys.stderr.write("\rWriting Code...  OK\x1b[K\n")
    open(chip, "wb").write(bytes(new))
    if "-v" not in a:
        bad = next((i for i, (x, y) in enumerate(zip(src, new)) if x != y), None)
        if bad is not None:
            print(f"Verification failed at address 0x{bad:04X}: File=0x{src[bad]:02X}, Device=0x{new[bad]:02X}",
                  file=sys.stderr)
            sys.exit(1)
        print("Verification OK", file=sys.stderr)
    sys.exit(0)
if "-r" in a:
    if os.environ.get("FAKE_ID") == "unknown":            # 2026-09-29: a DIP chip read as a TSOP32 part
        if "-y" not in a:
            print("Invalid Chip ID: expected 0x9732, got 0xFEFF (unknown)", file=sys.stderr)
            sys.exit(1)
    if os.environ.get("FAKE_ID") == "mismatch":
        if "-y" not in a:
            print("Invalid Chip ID: expected 0x8934, got 0x9732 (TMS27C020@DIP32)", file=sys.stderr)
            sys.exit(1)
        print("WARNING: Chip ID mismatch: expected 0x8934, got 0x9732 (TMS27C020@DIP32)", file=sys.stderr)
    src = chip or os.environ.get("FAKE_ROM")
    if not src or not os.path.exists(src):
        print("IO error: expected 64 bytes but 0 bytes transferred", file=sys.stderr)
        sys.exit(1)
    data = bytearray(open(src, "rb").read())
    cnt = os.environ.get("FAKE_COUNTER")
    n = 0
    if cnt:
        n = int(open(cnt).read() or 0) if os.path.exists(cnt) else 0
        open(cnt, "w").write(str(n + 1))
    if os.environ.get("FAKE_FLAKY") == "1" and n % 2 == 1:
        data[100] ^= 0x10
    for pct in (0, 50, 100):
        sys.stderr.write(f"\rReading Code...  {pct}%\x1b[K")
    sys.stderr.write("\rReading Code...  OK\x1b[K\n")
    open(opt("-r"), "wb").write(bytes(data))
    sys.exit(0)
print("fake-minipro: unsupported arguments " + " ".join(a), file=sys.stderr)
sys.exit(2)
