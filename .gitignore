# Input, not source: PROMPT.md + ref/ from the claude.ai project. M2 copies what belongs into data/ and docs/.
handoff/

# Local binaries and caches
*.AppImage
__pycache__/
*.pyc

# Secrets never go in git: AP PSK, Wi-Fi credentials, SSH keys, API tokens
.env
*.env
*.psk
*.key
*.pem
*.token
id_*
secrets/

# Local only, never public: site-specific values (owner, username, home network) and workplace data
*.local.md
*.local
.githooks/patterns.local
# ...and anything derived from it. A .bak made while editing it was picked up by
# `git add -A` on 2026-10-06 and reached a commit: the exact file the pattern list
# exists to keep out of this repo.
.githooks/patterns.local.*
data/gatbox-barcade-roster.json
data/gatbox-mame-sets.json
data/gatbox-manuals.json

# ROM dumps and manuals are copyrighted: never in the public repo
*.bin
roms/
*.pdf

# Claude Code: local permission choices on this Pi, not project settings
.claude/settings.local.json
