#!/usr/bin/env python3
"""gatbox-library: the game library's first fill and its imports (docs/plans/2026-11-03-phase-b-library.md).

  gatbox-library seed --plan [--out FILE]   read today's files (roster, manuals list, specs, MAME lists, dump archive) and
                                            write a plan: a proposed key for every game and what looks off. Read-only. The
                                            plan goes to your home directory, never into git: edit it, then --apply it.
  gatbox-library seed --apply PLAN          write the records in one transaction. Nothing already in the library is
                                            changed, so running it again changes nothing.
  gatbox-library import --kind K FILE       re-read one list file prepared off the deck (K: manuals, mame-sets, specs) and
                                            apply it as edits. It never confirms or unconfirms a limit.
  gatbox-library status                     what's in the library

Run it as the owner (group gatbox-manuals): the library folder is shared with gatbox-web.
"""
import argparse
import json
import os
import sys


def lib_path():
    env = os.environ.get("GATBOX_LIB")
    if env:
        return env
    here = os.path.dirname(os.path.realpath(__file__))
    repo = os.path.join(here, "..", "backend")
    return repo if os.path.isdir(os.path.join(repo, "gatboxlib")) else "/usr/local/lib/gatbox"


sys.path.insert(0, lib_path())
from gatboxlib import library, seed


def say_result(res, what):
    for r in res["rejected"]:
        print(f"  refused: {r['kind']} {r['id']}: {r['reason']}")
    for f in res["flags"]:
        print(f"  note: {f}")
    if res["rejected"]:
        print(f"\n{what}: nothing was written.")
        return 2
    print(f"\n{what}: {res['created']} created, {res['updated']} updated, {res['kept']} already there.")
    return 0


def open_library(src, create):
    path = src["library"]
    if not create and not os.path.isfile(path):
        sys.exit(f"no library at {path} yet: run seed --plan, then seed --apply")
    try:
        return library.Library(path, create=create)
    except OSError as e:
        sys.exit(f"can't open {path}: {e.strerror}. The install makes that folder; run the install first, as the owner.")


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    sd = sub.add_parser("seed")
    g = sd.add_mutually_exclusive_group(required=True)
    g.add_argument("--plan", action="store_true")
    g.add_argument("--apply", metavar="PLAN")
    sd.add_argument("--out", default=os.path.join("~", "gatbox-library-plan.json"))
    im = sub.add_parser("import")
    im.add_argument("--kind", required=True, choices=sorted(seed.LISTS))
    im.add_argument("file")
    sub.add_parser("status")
    a = ap.parse_args()
    src = seed.sources()

    if a.cmd == "seed" and a.plan:
        plan = seed.make_plan(src)
        out = os.path.expanduser(a.out)
        seed.write_plan(plan, out)
        print(f"{len(plan['games'])} games: " + ", ".join(f"{n} {k}" for k, n in sorted(plan["counts"].items())))
        for f in plan["flags"]:
            print(f"  check: {f}")
        print(f"\nPlan written to {out}. Edit a key to rename a game, give two slugs one key to make them one game, "
              f"or set \"skip\": true. Then: gatbox-library seed --apply {out}")
        return 0
    if a.cmd == "seed":
        try:
            with open(os.path.expanduser(a.apply), encoding="utf-8") as f:
                plan = json.load(f)
        except (OSError, ValueError) as e:
            sys.exit(f"can't read the plan: {e}")
        problems = seed.check_plan(plan)                 # before a library file is created for it
        if problems:
            return say_result({"created": 0, "updated": 0, "kept": 0, "flags": [],
                               "rejected": [{"kind": "plan", "id": "", "reason": x} for x in problems]}, "seed")
        return say_result(seed.apply_plan(open_library(src, True), src, plan), "seed")
    if a.cmd == "import":
        return say_result(seed.import_file(open_library(src, False), src, a.kind, a.file), "import")
    lib = open_library(src, False)
    print(f"library: {src['library']}")
    print(f"  seeded {lib.meta('seeded_at', 'never')} · {lib.size():,} bytes · digest {lib.digest()['digest'][:16]}")
    for kind, n in sorted(lib.counts().items()):
        print(f"  {kind:<11} {n}")
    return 0


sys.exit(main())
