[Unit]
Description=GATBOX: raise the hotspot when there is no network, drop it when one returns
Wants=NetworkManager.service
After=NetworkManager.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/gatbox-ap-fallback
# Type=oneshot disables the start timeout by default, and while this unit is still
# "activating" OnUnitActiveSec will not start it again -- so one hung nmcli would
# disable the recurring recovery permanently, on the unit whose job is reachability.
TimeoutStartSec=150
# nmcli's state strings are localized; the predicate matches them.
Environment=LC_ALL=C
# /var/lib/gatbox-ap-fallback: how many times each saved network has been tried and
# failed, so a profile whose password changed does not flap the hotspot every two
# minutes. Survives a reboot on purpose -- the password is still wrong after one.
StateDirectory=gatbox-ap-fallback

# No [Install] section: gatbox-ap-fallback.timer owns when this runs. It used to install
# itself into multi-user.target and ran exactly once, at boot.
