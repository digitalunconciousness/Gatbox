[Unit]
Description=GATBOX archive (the library's home: manuals, ROM images, limits and facts)
After=network.target

[Service]
# One process, two listeners (see gatboxarchive/server.py): the tunnel one on localhost for cloudflared, and an optional
# private one for the apps' pull jobs. Its settings are /etc/gatbox-archive/archive.conf; the data is on its own mount.
Type=simple
ExecStart=/usr/local/bin/gatbox-archive serve
EnvironmentFile=-/etc/gatbox-archive/archive.conf
User=gatbox-archive
Group=gatbox-archive
UMask=0027
Restart=always
RestartSec=5
# It writes /srv/archive and nothing else, runs nothing as root, and sees no devices or home directories.
ProtectSystem=strict
ReadWritePaths=/srv/archive
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
MemoryMax=512M
# It never calls out. Only this container's own loopback can reach it, plus the private network when a private listener is
# set: install.sh writes that as a drop-in from ARCHIVE_PRIVATE_ALLOW in archive.conf.
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
