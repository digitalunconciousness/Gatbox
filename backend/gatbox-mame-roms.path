# NOT INSTALLED YET: this is the repo copy for review. The bootstrap doesn't install it until the owner has seen the diff
# (BRINGUP.md, phase D4) and said yes.
[Unit]
Description=GATBOX: build ROM lists for games added after the seed (a request in /var/spool/gatbox-mame)

[Path]
PathExists=/var/spool/gatbox-mame/request.json
Unit=gatbox-mame-roms.service

[Install]
WantedBy=multi-user.target
