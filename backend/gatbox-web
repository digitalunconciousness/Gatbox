#!/usr/bin/env python3
"""gatbox-web: GATBOX's one web server on :80, for the phone view and the dashboard's JSON API.

    Phone view (HTML; every URL from before the API still works):
      /  /s/<csv>  /png/<csv>  /pdf/<csv>  /csv/<csv>  /font/<file>  POST /control
      GET /kiosk/state  POST /kiosk/exit  POST /kiosk/shutdown   (the 7" kiosk; the two POSTs: loopback only)
    JSON API (M4d), all under /api/: system, meter, meter/profile, meter/alarm, rail/live (SSE), rail/sessions,
      rail/report/<csv>, machine, mark, session/new, captures, devices, roster[/<slug>]

The code is the gatboxweb package (routes table: gatboxweb/server.py), next to gatboxlib in /usr/local/lib/gatbox.
Stdlib only. Runs gatbox-rail-report for the analysis so the numbers match the CLI.

Environment (the unit sets the first two; the tests set the rest):
  STATE_DIRECTORY   /var/lib/gatbox-web: Start/Stop flags, profile, machine, alarm switch, marks spool, captures
  CACHE_DIRECTORY   report JSON + plots
  GATBOX_LOGDIR  GATBOX_RUNDIR  GATBOX_WEB_PORT  GATBOX_REPORT  GATBOX_WEB_FONTS  GATBOX_DATA  GATBOX_LIB
"""
import os
import sys


def lib_path():
    env = os.environ.get("GATBOX_LIB")
    if env:
        return env
    here = os.path.dirname(os.path.realpath(__file__))
    return here if os.path.isdir(os.path.join(here, "gatboxweb")) else "/usr/local/lib/gatbox"


sys.path.insert(0, lib_path())
from gatboxweb.server import main  # noqa: E402

if __name__ == "__main__":
    main()
