def lib_path():
    env = os.environ.get("GATBOX_LIB")
    if env:
        return env
    repo = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "backend")
    return repo if os.path.isdir(os.path.join(repo, "gatboxlib")) else "/usr/local/lib/gatbox"


sys.path.insert(0, lib_path())
from gatboxlib.disks import (DISKS, MARKER, REFUSED, describe, disks, images, read_file,  # noqa: E402
                             same_drive, store_mounted)

DDRESCUE = os.environ.get("GATBOX_DDRESCUE", "ddrescue")
API = os.environ.get("GATBOX_API", "http://127.0.0.1")
LABEL = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,39}$")       # a drive label, safe as a file name
SLUG = re.compile(r"^[a-z0-9][a-z0-9-]{0,63}$")
MEDIA = ("hdd", "cf", "sd", "ssd")
FLASH = ("cf", "sd", "ssd")
SECTOR = 512                                                     # the IDE2SAT2 takes nothing else (note §4.2)
CHECK_FRESH_S = 300                                              # a TARGET CHECK is good for 5 minutes
CHUNK = 4 << 20                                                  # read and write in 4 MiB pieces
TICK_S = float(os.environ.get("GATBOX_DISK_TICK", "5"))          # a long step rewrites its progress at most this often
POLL_S = float(os.environ.get("GATBOX_DISK_POLL", "2"))          # how often a running ddrescue is looked at
HEAD_SCAN = 64 << 20                                             # what 'blank' and the fingerprint look at: the first 64 MiB
LOCK = ".gatbox-disk.lock"                                       # in the store: one read or write at a time


class Stop(Exception):
    """A reason to stop, for the person at the dock (and, later, the dashboard's result card)."""
    def __init__(self, what, hint="", **extra):
        super().__init__(what)
        self.what, self.hint, self.extra = what, hint, extra


def api(path):
    try:
        with urllib.request.urlopen(API + path, timeout=3) as r:
            return json.loads(r.read())
    except (OSError, ValueError):
        return None


def clock_source():
    s = api("/api/system")
    return ((s or {}).get("clock") or {}).get("source") or "unknown"


def current_machine():
    m = api("/api/machine")
    return (m or {}).get("slug") or "unassigned"


def now_iso():
    return datetime.datetime.now().astimezone().isoformat(timespec="seconds")


# --- what's plugged in ---------------------------------------------------------------------------------------------

def require_store():
    if not store_mounted():
        raise Stop("IMAGE STORE NOT CONNECTED",
                   f"plug in the image-store drive: {DISKS} must be its mount, with its {MARKER} marker")


def take_lock():
    """One disk read or write at a time, whoever started it (the dashboard's job or the terminal): an exclusive flock
    on a file in the store. Two of them on one drive would be a write racing a read. -> the open descriptor, which
    holds the lock until it is closed (and is released by the kernel if this process dies)."""
    fd = os.open(os.path.join(os.path.realpath(DISKS), LOCK), os.O_CREAT | os.O_RDWR, 0o664)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        os.close(fd)
        raise Stop("another disk read or write is running", "wait for it to finish, then try again") from None
    return fd


def pick(name):
    """The disk called NAME, if it may be a source or target; otherwise a Stop saying why."""
    for d in disks():
        if d["name"] == name:
            if d["role"] != "ok":
                what, hint = REFUSED[d["role"]]
                raise Stop(what.format(n=name, m=", ".join(d["mounted"])), hint)
            return d
    raise Stop(f"no USB disk called {name!r}", "gatbox-disk list shows what's plugged in (an SD card or NVMe drive "
               "on the Pi itself is never offered)")


# --- reading and hashing ---------------------------------------------------------------------------------------------

def _is_block(path):
    try:
        return stat.S_ISBLK(os.stat(path).st_mode)
    except OSError:
        return False


def hashed_read(path, length, sha256=False, on_progress=None):
    """SHA-1 (and SHA-256) of exactly the first LENGTH bytes of PATH. ON_PROGRESS(bytes so far) is called after every
    4 MiB piece, so a half-hour pass can say where it is; it must be cheap and must not raise. A block device is read with O_DIRECT, past the
    page cache, so a verify reads the drive and not memory, with no replug needed (note §1, row 6). The plain files
    that stand in for devices in the tests are read normally: tmpfs refuses O_DIRECT."""
    h1, h2 = hashlib.sha1(), (hashlib.sha256() if sha256 else None)
    direct = _is_block(path)
    fd = os.open(path, os.O_RDONLY | (os.O_DIRECT if direct else 0))
    try:
        buf = mmap.mmap(-1, CHUNK)                  # page-aligned, as O_DIRECT needs
        view = memoryview(buf)
        try:
            done = 0
            while done < length:
                want = min(CHUNK, length - done)
                if direct and want % SECTOR:
                    want += SECTOR - want % SECTOR  # O_DIRECT reads whole sectors; only LENGTH bytes are hashed
                n = os.preadv(fd, [view[:want]], done)
                if n <= 0:
                    raise Stop(f"{path} ended after {done:,} bytes, before {length:,}", "the drive or card went away")
                take = min(n, length - done)
                h1.update(view[:take])
                if h2:
                    h2.update(view[:take])
                done += take
                if on_progress:
                    on_progress(done)
        finally:
            view.release()
            buf.close()
    finally:
        os.close(fd)
    return (h1.hexdigest(), h2.hexdigest()) if h2 else h1.hexdigest()


def read_map(path):
    """GNU ddrescue's mapfile: comment lines, the status line, then one "pos size status" line per block, in hex.
    Status + is rescued; - bad sector; ? not tried; * not trimmed; / not scraped."""
    blocks, status_seen = [], False
    for line in read_file(path).splitlines():
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        f = line.split()
        if not status_seen:
            status_seen = True
            continue
        blocks.append((int(f[0], 0), int(f[1], 0), f[2]))
    return blocks


def map_summary(path, size):
    blocks = read_map(path)
    rescued = sum(s for _, s, st in blocks if st == "+")
    bad = [(p, s, st) for p, s, st in blocks if st != "+"]
    return {"rescued_bytes": rescued, "rescued_pct": round(100.0 * rescued / size, 3) if size else 0.0,
            "bad_areas": len(bad), "bad_bytes": sum(s for _, s, _ in bad),
            "complete": not bad and rescued == size}


def gb(n):
    """Bytes as the dashboard writes them: 55.4 GB, 812 MB."""
    return f"{n / 1e9:.1f} GB" if n >= 1e9 else f"{n / 1e6:.0f} MB"


def bytes_read(pid):
    """What a process has read so far: rchar in /proc/PID/io counts every read and pread it has made. ddrescue's reads are the
    source drive's (its map and its image are written, not read), and it does not wait for its map: it saves that every five
    minutes, so a pass could not be followed from it. None where the kernel won't say."""
    try:
        for line in read_file(f"/proc/{pid}/io").splitlines():
            if line.startswith("rchar:"):
                return int(line.split()[1])
    except (OSError, ValueError, IndexError):
        pass
    return None


# --- READ -------------------------------------------------------------------------------------------------------------

class Work:
    """One job's running record, printed as it goes and kept for the result."""
    def __init__(self, status=None, say=print):
        self.status_file, self.say = status, say
        self.info = {"steps": []}
        self.current, self._ticked = "", 0.0

    def step(self, name, detail="", progress=None):
        self.info["steps"].append({"step": name, "detail": detail, "at": round(time.time(), 3)})
        self.say(f"  {name}" + (f": {detail}" if detail else ""))
        self.current, self._ticked = name, time.monotonic()
        self._publish(name, detail, progress)

    def _publish(self, name, detail, progress):
        if self.status_file:
            tmp = self.status_file + ".tmp"
            with open(tmp, "w") as f:
                json.dump(dict(self.info, state="running", step=name, detail=detail, progress=progress), f)
            os.replace(tmp, self.status_file)

    def tick(self, detail, progress):
        """Where a long step has got to: the status file only (the dashboard reads it), not another entry in the steps.
        At most one write every TICK_S seconds, because the status file is on the SD card."""
        now = time.monotonic()
        if now - self._ticked < TICK_S:
            return
        self._ticked = now
        self._publish(self.current, detail, round(progress, 4))

    def _pass(self, what, size, lo, hi):
        """A tick for hashed_read: LO to HI of the bar over one pass of SIZE bytes."""
        return lambda done: self.tick(f"{what}: {gb(done)} of {gb(size)}", lo + (hi - lo) * done / size)


class Read(Work):
    """EXPECT: the identity the dashboard showed when the drive was picked. The job refuses a different drive."""
    def __init__(self, device, machine, label, media, realm=None, note="", expect=None, status=None, say=print):
        super().__init__(status, say)
        self.device, self.machine, self.label, self.media, self.expect = device, machine, label, media, expect
        self.info.update(op="read", device=device, machine=machine, label=label, media=media, realm=realm, note=note)

    def paths(self):
        folder = os.path.join(os.path.realpath(DISKS), self.machine)
        base = os.path.join(folder, self.label)
        return folder, base + ".img.part", base + ".map", base + ".read.json"

    def go(self, retry=False):
        require_store()
        lock = take_lock()
        try:
            return self._go(retry)
        finally:
            os.close(lock)

    def _go(self, retry):
        require_store()
        if not LABEL.match(self.label):
            raise Stop("label: 1-40 of letters, digits, '.', '_', '-' (it becomes the file name)")
        if self.machine != "unassigned" and not SLUG.match(self.machine):
            raise Stop(f"machine: not a roster slug: {self.machine!r}")
        if not retry and self.media not in MEDIA:
            raise Stop(f"media: one of {', '.join(MEDIA)}", "the tech picks it: a USB bridge can't tell a disk from flash")
        folder, part, mapf, state = self.paths()
        if retry:
            st = self._state(state)
            d = self._find_again(st["identity"])
            self.device, self.media = d["name"], st["media"]
            self.info.update(device=d["name"], media=st["media"], started=st["started"],
                             realm=st.get("realm"), note=st.get("note", ""))
        else:
            d = pick(self.device)
            if self.expect is not None and not same_drive(d["identity"], self.expect):
                raise Stop(f"{d['name']} is a different drive from the one picked ({describe(d['identity'])})",
                           "nothing was read: pick the drive again")
            os.makedirs(folder, exist_ok=True)
            if os.path.exists(state):                   # an interrupted read of the same drive and label: resume it
                st = self._state(state)
                if not same_drive(st["identity"], d["identity"]):
                    raise Stop(f"{self.label} was started on another drive ({describe(st['identity'])})",
                               "use another label, or finish that read with retry")
                self.info["started"] = st["started"]
            else:
                self.info["started"] = round(time.time(), 3)
                self._save_state(state, d["identity"])
        ident = d["identity"]
        self.info["source"] = ident
        self.step("identified", f"{d['name']}: {describe(ident)}", progress=0.02)
        size = ident["bytes"]
        if retry:
            self.step("retry", "ddrescue -r3 on the same map", progress=0.05)
            self._ddrescue(["-r3"], d["node"], part, mapf, size, retry=True)
        else:
            self.step("read", "ddrescue, one pass with no scraping", progress=0.05)
            self._ddrescue(["-n", "--sparse"], d["node"], part, mapf, size)
        summary = map_summary(mapf, size)
        self.info["ddrescue"] = summary
        if not summary["complete"]:
            raise Stop(f"bad areas: {summary['rescued_pct']}% rescued, {summary['bad_areas']} bad area(s), "
                       f"{summary['bad_bytes']:,} bytes not read",
                       "RETRY runs ddrescue -r3 on the same map. It's your call on an old drive: each pass spins it up",
                       needs_retry=True)
        self.step("hash", "SHA-1 and SHA-256", progress=0.8)
        flash = self.media in FLASH                 # a card is read a second time after this, so this pass ends earlier
        sha1, sha256 = hashed_read(part, size, sha256=True,
                                   on_progress=self._pass("SHA-1 and SHA-256", size, 0.8, 0.85 if flash else 0.97))
        self.info.update(sha1=sha1, sha256=sha256, bytes=size, reads=1)
        fd = os.open(part, os.O_RDONLY)          # the image's own first 64 MiB: no second look at a fragile source drive
        try:
            scan = scan_head(fd)
        finally:
            os.close(fd)
        self.info["fingerprint"] = {"bytes": scan["bytes"], "nonzero": scan["nonzero"], "sha1": scan["sha1"]}
        if self.media in FLASH:
            self.step("second read", "flash: the whole card again, past the cache", progress=0.85)
            again = hashed_read(d["node"], size, on_progress=self._pass("the card again", size, 0.85, 0.97))
            if again != sha1:
                raise Stop("the card reads differently twice: flaky",
                           "reseat it (or try another reader slot) and read again; the first read is kept as .part")
            self.info.update(reads=2, identical=True)
        self.store(folder, part, mapf, state)
        return self.info

    def _state(self, state):
        try:
            with open(state) as f:
                return json.load(f)
        except (OSError, ValueError):
            raise Stop(f"no read of {self.label} in progress for {self.machine}", "start it with read") from None

    def _save_state(self, state, ident):
        with open(state + ".tmp", "w") as f:
            json.dump({"identity": ident, "media": self.media, "started": self.info["started"],
                       "realm": self.info.get("realm"), "note": self.info.get("note", "")}, f)
        os.replace(state + ".tmp", state)

    def _find_again(self, ident):
        """The drive a read started on, wherever it's plugged in now (the dock's name for it can change)."""
        for d in disks():
            if same_drive(d["identity"], ident):
                if d["role"] != "ok":
                    what, hint = REFUSED[d["role"]]
                    raise Stop(what.format(n=d["name"], m=", ".join(d["mounted"])), hint)
                return d
        raise Stop(f"the drive this read started on isn't plugged in ({describe(ident)})",
                   "plug it back into the dock and wait for it to show in gatbox-disk list")

    def _ddrescue(self, opts, node, part, mapf, size=0, retry=False):
        """Run ddrescue and say where it is while it runs: the first pass from the bytes it has read (plus what an earlier,
        interrupted pass had already rescued); a retry only that it is still going, because it re-reads scattered bad areas."""
        have = map_summary(mapf, size)["rescued_bytes"] if size and not retry and os.path.exists(mapf) else 0
        started = time.monotonic()
        # Output goes to unlinked files beside the image, not a pipe nobody reads: ddrescue prints a screen a second, and a
        # full pipe would stop it. Not /tmp: that is RAM.
        with tempfile.TemporaryFile("w+", dir=os.path.dirname(part)) as out, \
                tempfile.TemporaryFile("w+", dir=os.path.dirname(part)) as err:
            p = subprocess.Popen([DDRESCUE, *opts, node, part, mapf], stdout=out, stderr=err, text=True)
            try:
                while True:
                    try:
                        rc = p.wait(timeout=POLL_S)
                        break
                    except subprocess.TimeoutExpired:
                        self._ddrescue_tick(p.pid, size, have, retry, started)
            except BaseException:                   # the job is being stopped: ddrescue goes with it (its map is kept)
                p.kill()
                p.wait()
                raise
            tails = []
            for f in (err, out):
                f.seek(0, os.SEEK_END)
                f.seek(max(0, f.tell() - 4096))
                tails.append(f.read())
        self.info.setdefault("passes", []).append({"opts": opts, "exit": rc, "at": round(time.time(), 3)})
        if rc != 0:
            tail = " / ".join(l for l in (tails[0].strip() or tails[1].strip()).splitlines()[-3:])
            raise Stop(f"ddrescue exited {rc}: {tail}", "the map and the partial image are kept; RETRY resumes")

    def _ddrescue_tick(self, pid, size, have, retry, started):
        mins = int((time.monotonic() - started) // 60)
        got = None if retry or not size else bytes_read(pid)
        if got is None:
            self.tick(f"{'retrying the bad areas' if retry else 'ddrescue is running'}: {mins} min so far", 0.05)
            return
        done = min(size, have + got)
        self.tick(f"{gb(done)} of {gb(size)} read from the drive", 0.05 + 0.73 * done / size)

    def stored_copy(self, folder, sha1):
        """(sidecar path, its contents) of an image in the store with these bytes, or None. Every machine's folder is searched, the
        one this read is for first: the same drive read again under another machine, or under none, is still the same bytes, and a
        second copy of a 40 GB image is not what anyone asked for. Only a sidecar with its .img inside the store counts, as in
        disks.images() (a read still in progress, <label>.read.json, and a sidecar whose image is gone do not)."""
        store = os.path.realpath(DISKS)
        sides = sorted(glob.glob(os.path.join(store, "*", "*.json")), key=lambda p: (os.path.dirname(p) != folder, p))
        for side in sides:
            img = side[:-5] + ".img"
            if side.endswith(".read.json") or not os.path.isfile(img) or not os.path.realpath(img).startswith(store + os.sep):
                continue
            try:
                with open(side) as f:
                    old = json.load(f)
            except (OSError, ValueError):
                continue
            if isinstance(old, dict) and old.get("sha1") == sha1:
                return side, old
        return None

    def store(self, folder, part, mapf, state):
        """Name the image after its label, its read's date and its SHA-1; never store the same bytes twice, whichever machine's folder
        they are in."""
        sha1 = self.info["sha1"]
        day = time.strftime("%Y%m%d", time.localtime(self.info["started"]))
        hit = self.stored_copy(folder, sha1)
        if hit:
            side, old = hit
            where = os.path.basename(os.path.dirname(side))
            old.setdefault("also_read", []).append({"date": day, "label": self.label, "machine": self.machine, "epoch": round(time.time(), 3)})
            with open(side + ".tmp", "w") as f:
                json.dump(old, f, indent=1)
            os.replace(side + ".tmp", side)
            for p in (part, mapf, state):
                os.remove(p)
            img = side[:-5] + ".img"
            self.info["stored"] = {"path": img, "new": False, "machine": where}
            self.step("store", "already in the store as " + (os.path.basename(img) if where == self.machine else f"{where}/{os.path.basename(img)}"), progress=1.0)
            return
        base = os.path.join(folder, f"{self.label}_{day}_{sha1[:8]}")
        if os.path.exists(base + ".img") or os.path.exists(base + ".json"):
            raise Stop(f"{base}.img already exists with different contents", "use another label")
        os.link(part, base + ".img")                    # never overwrites: link fails if the name exists
        os.remove(part)
        os.replace(mapf, base + ".map")
        self.info["stored"] = {"path": base + ".img", "new": True}
        # A drive that is not a machine's (an archive drive, a donor, someone's old disk) is never queued for the archive: the queue
        # is how a machine's image would reach its hub, and a personal drive's image must never go anywhere without a yes. Nothing
        # reads the queue today (checked 2026-11-15), and this keeps it that way for these.
        for_machine = self.machine != "unassigned"
        self.info["archive"] = {"state": "pending"} if for_machine else {"state": "none", "why": "not for a machine"}
        with open(os.open(base + ".json", os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644), "w") as f:
            json.dump(self.sidecar(), f, indent=1)
        os.remove(state)
        if for_machine:
            queue(sha1, self.info["sha256"], base + ".img", self.machine)
        self.step("store", base + ".img", progress=1.0)

    def sidecar(self):
        i = self.info
        return {"label": i["label"], "machine": i["machine"], "realm": i.get("realm"), "media": i["media"],
                "source": i["source"], "bytes": i["bytes"], "sha1": i["sha1"], "sha256": i["sha256"],
                "fingerprint": i.get("fingerprint"),
                "ddrescue": i["ddrescue"], "passes": i.get("passes", []), "reads": i["reads"],
                "identical": i.get("identical"),
                "mame": {"state": "not run", "why": "the MAME CHD check comes with Task 3"},
                "archive": i["archive"], "started": i["started"], "finished": round(time.time(), 3),
                "date": now_iso(), "clock": clock_source(), "note": i.get("note", ""), "also_read": [],
                "tool": "gatbox-disk"}


def queue(sha1, sha256, path, machine):
    """One line per image in <store>/archive-queue.jsonl, keyed by SHA-256. Phase D's sync drains it."""
    q = os.path.join(os.path.realpath(DISKS), "archive-queue.jsonl")
    for line in read_file(q).splitlines():
        try:
            if json.loads(line).get("sha256") == sha256:
                return
        except ValueError:
            continue
    with open(q, "a") as f:
        f.write(json.dumps({"sha256": sha256, "sha1": sha1, "path": path, "machine": machine, "kind": "disk_image",
                            "queued": round(time.time(), 3)}) + "\n")


# --- TARGET CHECK -------------------------------------------------------------------------------------------------------

def image_in_store(path):
    """An image this may write: a .img with its sidecar, inside the image store (relative to it, or absolute)."""
    store = os.path.realpath(DISKS)
    real = os.path.realpath(path if os.path.isabs(path) else os.path.join(store, path))
    if not real.startswith(store + os.sep) or not real.endswith(".img") or not os.path.isfile(real):
        raise Stop(f"{path!r} isn't an image in the store", "gatbox-disk list --images shows them")
    try:
        with open(real[:-4] + ".json") as f:
            side = json.load(f)
    except (OSError, ValueError):
        raise Stop(f"{os.path.basename(real)} has no sidecar", "only images this tool stored can be written") from None
    return real, side


def _fs(b, off):
    """The filesystem whose signature starts at OFF in B, and its label: FAT, exFAT, NTFS, ext2/3/4, ISO 9660, swap,
    LUKS. A read-only look at the first bytes, the same on a drive and on the plain files the tests use."""
    def at(o, n):
        return b[off + o:off + o + n]
    if at(0, 6) == b"LUKS\xba\xbe":
        return "crypto_LUKS", ""
    if at(3, 8) == b"EXFAT   ":
        return "exfat", ""
    if at(3, 8) == b"NTFS    ":
        return "ntfs", ""
    if at(510, 2) == b"\x55\xaa" and at(82, 5) == b"FAT32":
        return "vfat", at(71, 11).decode("ascii", "replace").strip()
    if at(510, 2) == b"\x55\xaa" and at(54, 3) == b"FAT":
        return "vfat", at(43, 11).decode("ascii", "replace").strip()
    if len(b) >= off + 1024 + 136 and at(1024 + 56, 2) == b"\x53\xef":
        return "ext4", at(1024 + 120, 16).rstrip(b"\0").decode("utf-8", "replace")
    if at(32769, 5) == b"CD001":
        return "iso9660", at(32808, 32).decode("ascii", "replace").strip()
    if at(4086, 10) == b"SWAPSPACE2":
        return "swap", ""
    return None, ""


def scan_head(fd, limit=HEAD_SCAN):
    """Read the first `limit` bytes of a drive: how many are not zero, whether they are all zero or all 0xFF, and their
    SHA-1. The non-zero count is the same number `dd ... | tr -d '\\000' | wc -c` gives on the bench, so the two can be
    compared. Read-only, in 4 MiB pieces."""
    h, total, nonzero, zero, ff, off = hashlib.sha1(), 0, 0, True, True, 0
    while off < limit:
        b = os.pread(fd, min(CHUNK, limit - off), off)
        if not b:
            break
        h.update(b)
        z = b.count(0)
        total, nonzero, off = total + len(b), nonzero + len(b) - z, off + len(b)
        zero, ff = zero and z == len(b), ff and b.count(255) == len(b)
    return {"bytes": total, "nonzero": nonzero, "zero": zero, "ff": ff, "sha1": h.hexdigest()}


def contents(node, logical=SECTOR):
    """What's on a drive now, read-only: its partition table (dos or gpt) and each partition's filesystem and label,
    or a filesystem on the whole drive. Blank = none of that, and the first 64 MiB all zeros (or all 0xFF): a raw arcade
    card has no signature at all, and its data can start well past sector 0. `fingerprint` describes those 64 MiB."""
    def read_at(fd, off, n):
        return os.pread(fd, n, off)
    fd = os.open(node, os.O_RDONLY)
    try:
        head = read_at(fd, 0, 1 << 20)
        out = {"table": None, "partitions": [], "fs": None, "label": ""}
        mbr = len(head) >= 512 and head[510:512] == b"\x55\xaa" and _fs(head, 0)[0] is None
        entries = []
        if mbr:
            for i in range(4):
                e = head[446 + 16 * i:446 + 16 * (i + 1)]
                ptype, start, count = e[4], struct.unpack("<I", e[8:12])[0], struct.unpack("<I", e[12:16])[0]
                if ptype and count:
                    entries.append((i + 1, start, count, f"0x{ptype:02x}"))
            if any(t == "0xee" for *_, t in entries) and head[logical:logical + 8] == b"EFI PART":
                gpt = head[logical:logical + 92]
                lba, n, size = struct.unpack("<Q", gpt[72:80])[0], struct.unpack("<I", gpt[80:84])[0], struct.unpack("<I", gpt[84:88])[0]
                raw = read_at(fd, lba * logical, min(n, 128) * size)
                entries = []
                for i in range(min(n, 128)):
                    e = raw[i * size:(i + 1) * size]
                    if len(e) < 128 or e[:16] == b"\0" * 16:
                        continue
                    first, last = struct.unpack("<Q", e[32:40])[0], struct.unpack("<Q", e[40:48])[0]
                    name = e[56:128].decode("utf-16-le", "replace").rstrip("\0")
                    entries.append((i + 1, first, last - first + 1, name or "gpt"))
                out["table"] = "gpt"
            else:
                out["table"] = "dos"
        for n, start, count, ptype in entries:
            b = read_at(fd, start * logical, 64 << 10)
            fs, label = _fs(b, 0)
            out["partitions"].append({"n": n, "start": start * logical, "bytes": count * logical, "type": ptype,
                                      "fs": fs, "label": label})
        if not entries:
            out["fs"], out["label"] = _fs(head, 0)
        scan = scan_head(fd)
        out["fingerprint"] = {"bytes": scan["bytes"], "nonzero": scan["nonzero"], "sha1": scan["sha1"]}
        out["blank"] = (not out["table"] and not out["fs"] and (scan["zero"] or scan["ff"]))
        return out
    finally:
        os.close(fd)


def say_contents(c):
    if c["blank"]:
        return "blank: no signatures found, and the first 64 MiB are empty"
    if c["table"]:
        parts = "; ".join(f"partition {p['n']} {p['bytes']:,} bytes" + (f" {p['fs']}" if p["fs"] else "")
                          + (f" '{p['label']}'" if p["label"] else "") for p in c["partitions"])
        return f"{c['table']} partition table: " + (parts or "no partitions")
    if c["fs"]:
        return f"a {c['fs']} filesystem on the whole drive" + (f" '{c['label']}'" if c["label"] else "")
    n = (c.get("fingerprint") or {}).get("nonzero")
    return "no partition table or filesystem found, but the first 64 MiB aren't empty" + (
        f" ({n:,} non-zero bytes)" if n else "")


def check(image, device, say=print, expect=None, restore=False):
    """The TARGET CHECK (the burn's BLANK CHECK): every reason to refuse, before anything is written.

    RESTORE (the owner, 2026-11-16) is the one deliberate way past "this is the drive the image came from": the image goes back
    onto its own drive, to undo what has been done to it since it was read. It only lifts that refusal. A drive that is
    positively another drive is still refused, the image must be a complete read, and the overwrite is always acknowledged."""
    require_store()
    img, side = image_in_store(image)
    d = pick(device)
    if expect is not None and not same_drive(d["identity"], expect):
        raise Stop(f"{d['name']} is a different drive from the one picked ({describe(d['identity'])})",
                   "pick the target again")
    ident, size = d["identity"], os.path.getsize(img)
    if ident["bytes"] < size:
        raise Stop(f"too small: {d['name']} holds {ident['bytes']:,} bytes, the image is {size:,}",
                   "a target must hold at least the image's bytes")
    if ident["logical"] != SECTOR:
        raise Stop(f"{d['name']} has {ident['logical']}-byte sectors", "the IDE2SAT2 needs 512-byte sectors")
    src = side.get("source") or {}
    head = min(size, HEAD_SCAN)
    same_head = hashed_read(d["node"], head) == hashed_read(img, head)       # the target starts with the image's own bytes
    # "This is the drive the image came from." The drive's own serial decides when both sides have one. Without, the make
    # and size cannot (a new card of the same make and size looks the same on the dock, and the dock names itself), so
    # what is on it does: the original reads like the image, a new card does not.
    same_make = src.get("model") == ident["model"] and src.get("vendor") == ident["vendor"]
    both = bool(src.get("serial") and ident.get("serial"))
    is_source = same_make and ((src["serial"] == ident["serial"]) if both else (src.get("bytes") == ident["bytes"] and same_head))
    proof = None
    if is_source and not restore:
        raise Stop("this is the drive the image came from",
                   "same model and serial: put the new drive on the dock, or use RESTORE to put the image back on this one" if both else
                   "same make and size, and it starts with the image's own bytes (the original, or a copy that already "
                   "holds it): put the new drive on the dock, or use RESTORE to put the image back on this one")
    if restore:
        if both and src["serial"] != ident["serial"]:
            raise Stop("this isn't the drive the image came from (its serial is different)",
                       "RESTORE puts an image back on its own drive. For another drive use WRITE")
        if not same_make:
            raise Stop("this isn't the drive the image came from (another make or model)",
                       "RESTORE puts an image back on its own drive. For another drive use WRITE")
        if not both and src.get("bytes") != ident["bytes"]:
            raise Stop("this isn't the drive the image came from (another size)",
                       "RESTORE puts an image back on its own drive. For another drive use WRITE")
        proof = "serial" if both else "make, model and size (this drive has no serial)"
        # The original is about to be overwritten with this image: it has to be a read that can be trusted whole. A hard disk
        # is read once, so a clean single pass with nothing unread is the bar; flash is read twice and both must match.
        rescued = side.get("ddrescue") or {}
        if not rescued.get("complete"):
            raise Stop("this image isn't a complete read of its drive (some of it was not read)",
                       "READ the drive again before it is restored: nothing was changed")
        if side.get("media") != "hdd" and side.get("reads") != 2:
            raise Stop("this image of a card was read once, not twice with both reads matching",
                       "READ the card again before it is restored: nothing was changed")
    c = contents(d["node"], ident["logical"])
    already = same_head and hashed_read(d["node"], size) == side.get("sha1")
    result = {"op": "check", "target_ok": True, "image": img, "sha1": side.get("sha1"), "bytes": size,
              "device": d["name"], "identity": ident, "contents": c, "needs_ack": restore or not c["blank"],
              "already_written": already, "restore": restore, "restore_proof": proof, "at": round(time.time(), 3)}
    say(f"  target  {d['name']}: {describe(ident)}")
    say(f"          {say_contents(c)}")
    if restore:
        say(f"          RESTORE: the drive this image came from (matched by {proof}); what is on it now is replaced")
    if already:
        say("          already holds this image: VERIFY ONLY is all it needs")
    return result


# --- WRITE --------------------------------------------------------------------------------------------------------------

class Write(Work):
    """The go-ahead is ARMED (the dashboard's hold on the Pi's own screen, checked by gatbox-web) or CONFIRM (the
    terminal: the target's model typed, once both drives are on screen). Every refusal from here on is logged."""
    def __init__(self, checked, ack=False, armed=None, confirm=None, machine=None, realm=None, status=None, say=print):
        super().__init__(status, say)
        self.checked, self.ack, self.armed, self.confirm = checked, ack, armed, confirm
        self.info.update(op="write", image=checked.get("image"), sha1=checked.get("sha1"), bytes=checked.get("bytes"),
                         device=checked.get("device"), ack=ack, armed=armed, machine=machine, realm=realm,
                         contents=checked.get("contents"), restore=bool(checked.get("restore")),
                         restore_proof=checked.get("restore_proof"))

    def go(self, verify_only=False):
        c = self.checked
        lock = None
        try:
            require_store()
            lock = take_lock()
            if not c.get("target_ok"):
                raise Stop("there's no passing TARGET CHECK", "check the drive first")
            if self.armed is not None:
                # An arm is a dict with a real expiry. Anything else (False, {}, a string for a time) is not an arm,
                # and an arm skips the typed model, so it is never taken on trust.
                until = self.armed.get("until") if isinstance(self.armed, dict) else None
                if isinstance(until, bool) or not isinstance(until, (int, float)):
                    raise Stop("the arm is malformed: it has no expiry", "nothing was written: hold WRITE again")
                if time.time() > until:
                    raise Stop("the 30-second arm ran out before the job started", "nothing was written: hold WRITE again")
            if time.time() - c.get("at", 0) > CHECK_FRESH_S:
                raise Stop("the TARGET CHECK is more than 5 minutes old", "check the drive again")
            if c.get("needs_ack") and not self.ack and not verify_only:
                raise Stop(("RESTORE overwrites the drive the image came from: " if c.get("restore") else "the target isn't blank: ")
                           + say_contents(c["contents"]), "acknowledge that it gets overwritten (--overwrite)")
            d = pick(c["device"])
            if not same_drive(d["identity"], c["identity"]):
                raise Stop(f"{c['device']} is a different drive from the one checked ({describe(d['identity'])})",
                           "nothing was written: check the drive that's on the dock now")
            # The TARGET CHECK said whether the drive was blank, some minutes ago, and a different drive of the same make
            # and size looks the same. What is on it is read again now, and that is what decides about --overwrite.
            fresh = contents(d["node"], d["identity"]["logical"])
            self.info["contents"] = fresh
            was = (c["contents"] or {}).get("fingerprint")
            if was and was != fresh.get("fingerprint"):
                raise Stop(f"what is on {c['device']} changed since the check: its first 64 MiB are not the ones that were checked",
                           "a different card or drive on the dock? nothing was written: run the check again")
            if not fresh["blank"] and not self.ack and not verify_only:
                raise Stop("the target isn't blank: " + say_contents(fresh),
                           "acknowledge that it gets overwritten (--overwrite)")
            img, side = image_in_store(c["image"])
            if side.get("sha1") != c["sha1"]:
                raise Stop("the image changed since the check", "check again")
            size = c["bytes"]
            if os.path.getsize(img) != size:
                raise Stop("the image's size changed since the check", "nothing was written: check again")
            # The sidecar's SHA-1 was made when the image was stored; the file has had time to go wrong since. Its own
            # bytes are hashed once, before the target is touched: a damaged image is refused, not written and then
            # found out by the read-back.
            self.step("image", "reading the image once to check it against its checksum", progress=0.01)
            if hashed_read(img, size, on_progress=self._pass("the image against its checksum", size, 0.01, 0.05)) != c["sha1"]:
                raise Stop("the image in the store doesn't match its own checksum",
                           "it was damaged after it was stored: nothing was written. Read the original drive again")
            self.info["target"] = d["identity"]
            if self.armed is None and (self.confirm is None or not self.confirm(self)):
                raise Stop("the model wasn't typed: nothing was written")
            try:
                # on a block device this claim is refused while anything holds it; VERIFY ONLY only reads, so it asks for no more
                fd = os.open(d["node"], (os.O_RDONLY if verify_only else os.O_WRONLY) | os.O_EXCL)
            except OSError as e:
                if e.errno == errno.EBUSY:
                    raise Stop(f"{d['name']} is busy: something has it mounted or open", "nothing was written") from None
                if e.errno in (errno.EROFS, errno.EACCES, errno.EPERM):
                    raise Stop(f"{d['name']} is write-protected or read-only", "check the card's lock switch: nothing was written") from None
                raise
            self.info["verify_only"] = verify_only
            try:
                # The claim is made, so nothing can swap under it from here without this descriptor going stale. The
                # drive is identified once more, and the descriptor's own size compared, before anything is written.
                again = pick(c["device"])
                if not same_drive(again["identity"], c["identity"]) or os.lseek(fd, 0, os.SEEK_END) != c["identity"]["bytes"]:
                    raise Stop(f"{c['device']} is a different drive from the one checked ({describe(again['identity'])})",
                               "nothing was written: check the drive that's on the dock now")
                if not verify_only:
                    self.info["written"] = True     # from here on a stop leaves the drive partly written
                    self.step("write", f"{size:,} bytes to {d['name']}", progress=0.05)
                    with open(img, "rb") as src:
                        done = 0
                        while done < size:
                            piece = memoryview(src.read(min(CHUNK, size - done)))
                            if not piece:
                                raise Stop("the image ended early", "the store's copy is damaged: nothing more written")
                            off = 0
                            while off < len(piece):         # pwrite may take less than it was given: finish the piece
                                n = os.pwrite(fd, piece[off:], done + off)
                                if n <= 0:
                                    raise Stop("the drive stopped taking data", "it is partly written now: try another one")
                                off += n
                            done += len(piece)
                            self.tick(f"{gb(done)} of {gb(size)} written to {d['name']}", 0.05 + 0.55 * done / size)
                    os.fsync(fd)
                # The bar: the image's own check 1% to 5%, the write 5% to 60%, then the two read-backs share 60% to 97% equally. A
                # VERIFY ONLY has no write, so its two read-backs share 5% to 97%.
                first = 0.05 if verify_only else 0.60
                span = (0.97 - first) / 2
                for n in (1, 2):
                    lo = first + span * (n - 1)
                    self.step("verify", f"read-back {n} of 2, exactly {size:,} bytes, past the cache", progress=round(lo, 4))
                    got = hashed_read(d["node"], size, on_progress=self._pass(f"read-back {n} of 2", size, lo, lo + span))
                    if got != c["sha1"]:
                        raise Stop(f"verify {n} doesn't match the image (SHA-1 {got[:12]}…)",
                                   "the drive didn't take the image: try another one")
            finally:
                os.close(fd)
            beyond = d["identity"]["bytes"] - size
            self.info.update(verified=True, state="done", untouched_bytes=beyond)
            self.step("verified", f"{size:,} bytes written and read back twice; {beyond:,} bytes beyond them untouched",
                      progress=1.0)
            return self.info
        except Stop as s:
            self.info.update(state="stopped", error=s.what, hint=s.hint)
            raise
        except Exception as e:                      # a crash mid-write is still logged, as stopped
            self.info.update(state="stopped", error=f"gatbox-disk failed: {e!r}")
            raise
        finally:
            if lock is not None:
                os.close(lock)
            self.log()

    def log(self):
        """One line per write, stopped or verified, in <store>/writes.jsonl (only on the store itself)."""
        if not store_mounted():
            return
        i = self.info
        line = {"date": now_iso(), "epoch": round(time.time(), 3), "state": "verified" if i.get("verified") else "stopped",
                "image": i.get("image"), "sha1": i.get("sha1"), "bytes": i.get("bytes"), "target": i.get("target"),
                "device": i.get("device"), "machine": i.get("machine"), "realm": i.get("realm"), "ack": i.get("ack"),
                "armed": i.get("armed"), "contents": i.get("contents"), "untouched_bytes": i.get("untouched_bytes"),
                "written": bool(i.get("written")), "verify_only": bool(i.get("verify_only")), "error": i.get("error"),
                "restore": bool(i.get("restore")), "restore_proof": i.get("restore_proof"), "tool": "gatbox-disk"}
        with open(os.path.join(os.path.realpath(DISKS), "writes.jsonl"), "a") as f:
            f.write(json.dumps(line) + "\n")


# --- FORMAT ---------------------------------------------------------------------------------------------------------------
# A quick format of a target drive (docs/plans/2026-11-16-restore-and-format.md; the owner's decisions of 2026-11-16: FAT32, exFAT or
# ext4, quick only, MBR up to 2 TB and GPT above, a warning and an offer to image first when the store has no image of the drive).
# It is a disk write under hard rule 6, so it goes the way WRITE goes: a check first, the arm or the typed model, the drive held
# with O_EXCL and identified again, everything written read back twice.
#
# The job can open whole USB disks and nothing else: partition nodes are root's, and it has no capability to make the kernel read a
# partition table again. So no mkfs ever sees the drive. The filesystem is made in a sparse scratch file on the store, checked there
# with its own fsck, and only then are the bytes it wrote copied through the one exclusive descriptor, the partition table last (a
# format that stops partway leaves a drive with no table, not a table that points at half a filesystem).

MIB = 1 << 20
FORMATS = {"fat32": "FAT32", "exfat": "exFAT", "ext4": "ext4"}
FLABEL = re.compile(r"^[A-Z0-9][A-Z0-9_-]{0,10}$")                # fits all three: FAT's 11 characters, no lower case
FORMAT_MIN = 16 * MIB                                            # a smaller drive is not formatted here
FAT32_MIN = 33 * MIB                                             # FAT32 needs 65,525 clusters: a smaller partition gets FAT16 or FAT12
FORMAT_DIR = "_format"                                           # the scratch files, in the store
FORMAT_ROOM = 2048 * MIB                                         # free space the store needs for one (an ext4 journal is up to 1 GiB)
RESCAN_S = float(os.environ.get("GATBOX_DISK_RESCAN", "6"))      # how long to watch for the kernel's new partition list
GPT_BASIC, GPT_LINUX = "EBD0A0A2-B9E5-4433-87C0-68B6B72699C7", "0FC63DAF-8483-4772-8E79-3D69D8477DE4"
MKFS_ENV = dict(os.environ, PATH=os.environ.get("PATH", "") + ":/usr/sbin:/sbin", LC_ALL="C")


def format_layout(nbytes, fs):
    """Where the one partition goes on a drive of NBYTES, and which table: MBR while the drive's sectors fit its 32 bits (2 TiB), GPT
    above. The partition starts at 1 MiB and ends on a MiB at least 1 MiB before the end (a GPT keeps its copy there)."""
    if fs not in FORMATS:
        raise Stop(f"filesystem: one of {', '.join(FORMATS)}")
    if nbytes < FORMAT_MIN:
        raise Stop(f"too small to format here: {nbytes:,} bytes", f"the smallest is {FORMAT_MIN // MIB} MB")
    start, end = MIB, (nbytes - MIB) // MIB * MIB
    size = end - start
    if fs == "fat32" and size >= 1 << 41:
        raise Stop("FAT32 stops at 2 TB, and this drive is bigger", "pick exFAT or ext4")
    return {"table": "dos" if nbytes // SECTOR <= 0xFFFFFFFF else "gpt", "start": start, "bytes": size, "fs": fs,
            "made": "FAT16" if fs == "fat32" and size < FAT32_MIN else FORMATS[fs]}


def _chs(lba):
    c, rest = divmod(lba, 255 * 63)
    h, sec = divmod(rest, 63)
    if c > 1023:
        c, h, sec = 1023, 254, 62
    return bytes([h, ((c >> 2) & 0xC0) | (sec + 1), c & 0xFF])


def mbr_sector(ptype, start_lba, count):
    """A DOS partition table with one entry (not bootable) and no boot code."""
    entry = b"\0" + _chs(start_lba) + bytes([ptype]) + _chs(start_lba + count - 1) + struct.pack("<II", start_lba, count)
    return b"\0" * 440 + os.urandom(4) + b"\0\0" + entry + b"\0" * 48 + b"\x55\xaa"


def gpt_pair(sectors, start_lba, count, type_guid, name):
    """(the drive's first 34 sectors, its last 33): a protective MBR, the GPT header and its 128 entries, and their copy at the end."""
    entry = (uuid.UUID(type_guid).bytes_le + uuid.uuid4().bytes_le + struct.pack("<QQQ", start_lba, start_lba + count - 1, 0)
             + name.encode("utf-16-le")[:72].ljust(72, b"\0"))
    entries = entry.ljust(128 * 128, b"\0")
    disk = uuid.uuid4().bytes_le

    def header(me, other, table):
        h = struct.pack("<8sIIIIQQQQ16sQIII", b"EFI PART", 0x10000, 92, 0, 0, me, other, 34, sectors - 34, disk, table, 128, 128,
                        zlib.crc32(entries))
        return (h[:16] + struct.pack("<I", zlib.crc32(h)) + h[20:]).ljust(SECTOR, b"\0")
    protective = (b"\0" * 446 + b"\0\0\x02\0\xee\xff\xff\xff" + struct.pack("<II", 1, min(sectors - 1, 0xFFFFFFFF))
                  + b"\0" * 48 + b"\x55\xaa")
    return protective + header(1, sectors - 1, 2) + entries, entries + header(sectors - 1, 1, sectors - 33)


def _tool(name):
    path = shutil.which(name, path=MKFS_ENV["PATH"])
    if not path:
        raise Stop(f"{name} isn't installed on this Pi", "the bootstrap installs it (dosfstools, exfatprogs, e2fsprogs): nothing was written")
    return path


def _run_tool(argv, env=None):
    try:
        r = subprocess.run(argv, capture_output=True, text=True, timeout=900, env=env or MKFS_ENV)
    except subprocess.TimeoutExpired:
        raise Stop(f"{os.path.basename(argv[0])} did not finish in 15 minutes", "nothing was written to the drive") from None
    return r.returncode, (r.stderr or r.stdout or "").strip().splitlines()[-1:] or [""]


def data_extents(path):
    """The parts of a sparse file that hold data: [(offset, length)], each rounded out to whole sectors."""
    out, fd = [], os.open(path, os.O_RDONLY)
    try:
        end, off = os.fstat(fd).st_size, 0
        while off < end:
            try:
                d = os.lseek(fd, off, os.SEEK_DATA)
            except OSError:                         # ENXIO: nothing but a hole from here on
                break
            off = os.lseek(fd, d, os.SEEK_HOLE)
            a, b = d // SECTOR * SECTOR, min(end, -(-off // SECTOR) * SECTOR)
            if out and a <= out[-1][0] + out[-1][1]:
                out[-1] = (out[-1][0], b - out[-1][0])
            else:
                out.append((a, b - a))
    finally:
        os.close(fd)
    return out


def make_filesystem(path, lay, label):
    """Make the filesystem in the scratch file PATH (sparse, the partition's size) and check it with its own fsck. -> what was made
    (FAT32, FAT16, FAT12, exFAT, ext4). Nothing here touches a drive: a mkfs or fsck that fails stops the format before it starts."""
    with open(path, "wb") as f:
        f.truncate(lay["bytes"])
    fs, made = lay["fs"], FORMATS[lay["fs"]]
    if fs == "fat32":
        # -h: the partition's first sector, as a partitioned drive's boot sector says it; -g: the geometry every USB bridge reports
        argv = ([_tool("mkfs.fat")] + (["-F", "32"] if lay["bytes"] >= FAT32_MIN else []) + (["-n", label] if label else [])
                + ["-h", str(lay["start"] // SECTOR), "-g", "255/63", path])
        check = [_tool("fsck.fat"), "-n", path]
        env = None
    elif fs == "exfat":
        argv = [_tool("mkfs.exfat"), "-q"] + (["-L", label] if label else []) + [path]
        check = [_tool("fsck.exfat"), "-n", path]
        env = None
    else:
        # On a file mke2fs marks what it zeroes as holes, and takes a file's holes for a drive that discards to zeros. Copied to a
        # drive, holes are whatever was there before. nodiscard and UNIX_IO_NOZEROOUT make it write its zeros, as it would on a drive
        # with neither: the journal is zeroed for real, and the inode tables are left for the kernel to zero and flagged so.
        argv = ([_tool("mkfs.ext4"), "-q", "-F"] + (["-L", label] if label else [])
                + ["-E", "nodiscard,lazy_itable_init=1,lazy_journal_init=0", path])
        check = [_tool("e2fsck"), "-fn", path]
        env = dict(MKFS_ENV, UNIX_IO_NOZEROOUT="1")
    rc, last = _run_tool(argv, env)
    if rc != 0:
        raise Stop(f"{os.path.basename(argv[0])} failed: {last[0][:160]}", "nothing was written to the drive")
    with open(path, "rb") as f:
        head = f.read(4096)
    if fs == "fat32":
        kind = head[82:87] if head[82:85] == b"FAT" else head[54:59]
        made = {b"FAT32": "FAT32", b"FAT16": "FAT16", b"FAT12": "FAT12"}.get(bytes(kind))
        if made is None:
            raise Stop("mkfs.fat made something that isn't FAT", "nothing was written to the drive")
        if made == "FAT32":
            spc, reserved, nfats = head[13], struct.unpack("<H", head[14:16])[0], head[16]
            total, fatsz = struct.unpack("<I", head[32:36])[0], struct.unpack("<I", head[36:40])[0]
            if spc == 0 or (total - reserved - nfats * fatsz) // spc < 65525:
                raise Stop("the FAT32 that was made has too few clusters to be FAT32", "nothing was written to the drive")
    elif fs == "ext4" and struct.unpack("<I", head[1024 + 0x5C:1024 + 0x60])[0] & 4:
        journal = struct.unpack("<I", head[1024 + 0x10C + 64:1024 + 0x10C + 68])[0] | struct.unpack("<I", head[1024 + 0x10C + 60:1024 + 0x10C + 64])[0] << 32
        if sum(n for _, n in data_extents(path)) < journal:
            raise Stop("this Pi's mkfs.ext4 left the journal as a hole in the scratch file, so it can't be copied to a drive safely",
                       "nothing was written to the drive: pick FAT32 or exFAT")
    rc, last = _run_tool(check)
    if rc != 0:
        raise Stop(f"the new filesystem did not pass its own check ({os.path.basename(check[0])}: {last[0][:120]})",
                   "nothing was written to the drive")
    return made


def stored_evidence(d, drive_head):
    """What the store holds of this drive, from the sidecars: an image read from it (by its serial; without one, by make, model and
    size), and whether the drive still starts with that image's bytes (DRIVE_HEAD(n) -> the SHA-1 of the drive's first n bytes)."""
    ident, out, store = d["identity"], [], os.path.realpath(DISKS)
    for side in sorted(glob.glob(os.path.join(store, "*", "*.json"))):
        if side.endswith(".read.json") or not os.path.isfile(side[:-5] + ".img"):
            continue
        try:
            with open(side) as f:
                j = json.load(f)
        except (OSError, ValueError):
            continue
        src, fp = j.get("source") or {}, j.get("fingerprint") or {}
        both = bool(src.get("serial") and ident.get("serial"))
        mine = (src["serial"] == ident["serial"]) if both else (not src.get("serial") and not ident.get("serial")
                                                                 and all(src.get(k) == ident.get(k) for k in ("vendor", "model", "bytes")))
        same = None
        if fp.get("sha1") and isinstance(fp.get("bytes"), int) and 0 < fp["bytes"] <= min(ident["bytes"], HEAD_SCAN):
            same = drive_head(fp["bytes"]) == fp["sha1"]
        if mine or same:
            out.append({"image": os.path.relpath(side[:-5] + ".img", store), "label": j.get("label"), "machine": j.get("machine"),
                        "date": j.get("date"), "from_this_drive": mine, "by": ("serial" if both else "make, model and size") if mine else None,
                        "head_same": same})
    return out


def format_check(device, fs, label="", say=print, expect=None):
    """The FORMAT CHECK: every reason to refuse, what is on the drive now, and whether the store has an image of it."""
    require_store()
    label = (label or "").strip().upper()
    if label and not FLABEL.match(label):
        raise Stop("label: up to 11 of A-Z, 0-9, '_' and '-'", "or leave it empty")
    d = pick(device)
    if expect is not None and not same_drive(d["identity"], expect):
        raise Stop(f"{d['name']} is a different drive from the one picked ({describe(d['identity'])})", "pick the drive again")
    ident = d["identity"]
    if ident["logical"] != SECTOR:
        raise Stop(f"{d['name']} has {ident['logical']}-byte sectors", "only 512-byte sectors are formatted here")
    lay = format_layout(ident["bytes"], fs)
    c = contents(d["node"], ident["logical"])
    heads = {c["fingerprint"]["bytes"]: c["fingerprint"]["sha1"]}

    def drive_head(n):
        if n not in heads:
            heads[n] = hashed_read(d["node"], n)
        return heads[n]
    stored = [] if c["blank"] else stored_evidence(d, drive_head)
    has = any(e["head_same"] for e in stored)
    result = {"op": "format_check", "target_ok": True, "device": d["name"], "identity": ident, "contents": c, "layout": lay,
              "label": label, "needs_ack": not c["blank"], "stored": stored, "has_image": has,
              "warn_no_image": not c["blank"] and not has, "at": round(time.time(), 3)}
    say(f"  target  {d['name']}: {describe(ident)}")
    say(f"          {say_contents(c)}")
    say(f"  format  {'MBR' if lay['table'] == 'dos' else 'GPT'}, one partition of {lay['bytes']:,} bytes, {lay['made']}" + (f" '{label}'" if label else ""))
    if result["warn_no_image"]:
        say("          THE STORE HAS NO IMAGE OF WHAT IS ON THIS DRIVE NOW: read it first if any of it matters")
    return result


class Format(Work):
    """The go-ahead is ARMED (the hold on the Pi's own screen) or CONFIRM (the terminal: the model typed), as for a write."""
    def __init__(self, checked, ack=False, armed=None, confirm=None, status=None, say=print):
        super().__init__(status, say)
        self.checked, self.ack, self.armed, self.confirm = checked, ack, armed, confirm
        self.info.update(op="format", device=checked.get("device"), layout=checked.get("layout"), label=checked.get("label"),
                         ack=ack, armed=armed, contents=checked.get("contents"), has_image=checked.get("has_image"))

    def go(self):
        c, lock, scratch = self.checked, None, None
        try:
            require_store()
            lock = take_lock()
            if not c.get("target_ok") or c.get("op") != "format_check":
                raise Stop("there's no passing FORMAT CHECK", "check the drive first")
            if self.armed is not None:
                until = self.armed.get("until") if isinstance(self.armed, dict) else None
                if isinstance(until, bool) or not isinstance(until, (int, float)):
                    raise Stop("the arm is malformed: it has no expiry", "nothing was written: hold FORMAT again")
                if time.time() > until:
                    raise Stop("the 30-second arm ran out before the job started", "nothing was written: hold FORMAT again")
            if time.time() - c.get("at", 0) > CHECK_FRESH_S:
                raise Stop("the FORMAT CHECK is more than 5 minutes old", "check the drive again")
            d = pick(c["device"])
            if not same_drive(d["identity"], c["identity"]):
                raise Stop(f"{c['device']} is a different drive from the one checked ({describe(d['identity'])})",
                           "nothing was written: check the drive that's on the dock now")
            fresh = contents(d["node"], d["identity"]["logical"])
            self.info["contents"] = fresh
            was = (c["contents"] or {}).get("fingerprint")
            if was and was != fresh.get("fingerprint"):
                raise Stop(f"what is on {c['device']} changed since the check: its first 64 MiB are not the ones that were checked",
                           "a different card or drive on the dock? nothing was written: run the check again")
            if not fresh["blank"] and not self.ack:
                raise Stop("the drive isn't blank: " + say_contents(fresh), "acknowledge that it gets erased (--overwrite)")
            nbytes, label = d["identity"]["bytes"], str(c.get("label") or "")
            lay = format_layout(nbytes, (c.get("layout") or {}).get("fs"))
            if lay != c.get("layout") or (label and not FLABEL.match(label)):
                raise Stop("the check doesn't fit this drive any more", "nothing was written: check it again")
            self.info["target"] = d["identity"]
            if self.armed is None and (self.confirm is None or not self.confirm(self)):
                raise Stop("the model wasn't typed: nothing was written")
            # the filesystem, made and checked in the store before the drive is touched
            folder = os.path.join(os.path.realpath(DISKS), FORMAT_DIR)
            os.makedirs(folder, exist_ok=True)
            for old in os.listdir(folder):                      # a scratch file a killed job left: one format at a time, so it is nobody's
                os.remove(os.path.join(folder, old))
            if shutil.disk_usage(folder).free < FORMAT_ROOM:
                raise Stop("the store needs 2 GB free to prepare a format", "nothing was written to the drive")
            scratch = os.path.join(folder, f"{os.getpid()}.fs")
            self.step("make", f"{lay['made']} for {lay['bytes']:,} bytes, made and checked in the store first", progress=0.02)
            made = make_filesystem(scratch, lay, label)
            self.info["made"] = made
            sectors, first, count = nbytes // SECTOR, lay["start"] // SECTOR, lay["bytes"] // SECTOR
            if lay["table"] == "dos":
                ptype = {"FAT32": 0x0C, "FAT16": 0x06 if lay["bytes"] >= 32 * MIB else 0x04, "FAT12": 0x01, "exFAT": 0x07, "ext4": 0x83}[made]
                head, tail = mbr_sector(ptype, first, count), b""
            else:
                head, tail = gpt_pair(sectors, first, count, GPT_LINUX if made == "ext4" else GPT_BASIC, label or "GATBOX")
            # What is written, as pieces that don't overlap: the filesystem's own bytes (and the partition's first and last MiB whole,
            # zeros included, so no older filesystem's signature survives there), the drive's last MiB, and its first MiB last of all.
            edge = [(0, min(MIB, lay["bytes"])), (max(0, lay["bytes"] - MIB), min(MIB, lay["bytes"]))]
            spans = []
            for a, n in sorted(data_extents(scratch) + edge):
                if spans and a <= spans[-1][0] + spans[-1][1]:
                    spans[-1] = (spans[-1][0], max(spans[-1][1], a + n - spans[-1][0]))
                else:
                    spans.append((a, n))
            pieces = [(lay["start"] + a, n, a) for a, n in spans]
            pieces.append((nbytes - MIB, MIB, (b"\0" * (MIB - len(tail)) + tail)))
            pieces.append((0, MIB, head.ljust(MIB, b"\0")))
            total = sum(n for _, n, _ in pieces)
            self.info["bytes"] = total
            try:
                fd = os.open(d["node"], os.O_WRONLY | os.O_EXCL)
            except OSError as e:
                if e.errno == errno.EBUSY:
                    raise Stop(f"{d['name']} is busy: something has it mounted or open", "nothing was written") from None
                if e.errno in (errno.EROFS, errno.EACCES, errno.EPERM):
                    raise Stop(f"{d['name']} is write-protected or read-only", "check the card's lock switch: nothing was written") from None
                raise
            src = os.open(scratch, os.O_RDONLY)
            try:
                again = pick(c["device"])
                if not same_drive(again["identity"], c["identity"]) or os.lseek(fd, 0, os.SEEK_END) != nbytes:
                    raise Stop(f"{c['device']} is a different drive from the one checked ({describe(again['identity'])})",
                               "nothing was written: check the drive that's on the dock now")
                self.info["written"] = True                 # from here on a stop leaves the drive partly formatted
                self.step("write", f"{total:,} bytes to {d['name']}, the partition table last", progress=0.10)
                # First the old table goes: the drive's first MiB is zeroed (and reaches the drive) before anything else, so a format that
                # stops partway leaves no table at all, never the old one pointing into half a new filesystem. The new table is the last piece.
                wipe = bytes(MIB)
                if os.pwrite(fd, wipe, 0) != MIB:
                    raise Stop("the drive stopped taking data", "nothing of the format was written: try again, or another drive")
                os.fsync(fd)
                want, done = hashlib.sha1(), 0
                for off, n, what in pieces:
                    want.update(struct.pack("<QQ", off, n))
                    at = 0
                    while at < n:
                        piece = what[at:at + CHUNK] if isinstance(what, bytes) else os.pread(src, min(CHUNK, n - at), what + at)
                        if not piece:
                            raise Stop("the scratch file ended early", "the drive is partly formatted: format it again")
                        want.update(piece)
                        sent = 0
                        while sent < len(piece):
                            k = os.pwrite(fd, piece[sent:], off + at + sent)
                            if k <= 0:
                                raise Stop("the drive stopped taking data", "it is partly formatted now: try again, or another drive")
                            sent += k
                        at += len(piece)
                        done += len(piece)
                        self.tick(f"{gb(done)} of {gb(total)} written to {d['name']}", 0.10 + 0.40 * done / total)
                os.fsync(fd)
                for n in (1, 2):
                    lo = 0.50 + 0.235 * (n - 1)
                    self.step("verify", f"read-back {n} of 2 of everything written, past the cache", progress=round(lo, 4))
                    if self._read_back(d["node"], pieces) != want.hexdigest():
                        raise Stop(f"read-back {n} doesn't match what was written", "the drive didn't take the format: try another one")
            finally:
                os.close(src)
                os.close(fd)
            now = contents(d["node"], SECTOR)
            parts = now["partitions"]
            family = {"FAT32": "vfat", "FAT16": "vfat", "FAT12": "vfat", "exFAT": "exfat", "ext4": "ext4"}[made]
            if (now["table"] != lay["table"] or len(parts) != 1 or parts[0]["start"] != lay["start"] or parts[0]["bytes"] != lay["bytes"]
                    or parts[0]["fs"] != family or (label and family != "exfat" and parts[0]["label"] != label)):
                raise Stop("read again, the drive doesn't show the partition and filesystem that were written: " + say_contents(now),
                           "format it again, or try another drive")
            self.info["contents_after"] = now
            # The kernel still holds the old partition list. udev reads it again when a writer closes a whole disk; whether it has
            # is looked up here and said, never assumed.
            seen, until = None, time.monotonic() + RESCAN_S
            while True:
                seen = next((x["partitions"] for x in disks() if x["name"] == d["name"]), None)
                if seen == [d["name"] + "1"] or time.monotonic() >= until:
                    break
                time.sleep(0.5)
            self.info.update(verified=True, state="done", kernel={"partitions": seen, "current": seen == [d["name"] + "1"]})
            self.step("verified", f"{d['name']} is {'MBR' if lay['table'] == 'dos' else 'GPT'} with one {made} partition"
                      + (f" '{label}'" if label else "") + f": {total:,} bytes written and read back twice", progress=1.0)
            return self.info
        except Stop as s:
            self.info.update(state="stopped", error=s.what, hint=s.hint)
            raise
        except Exception as e:
            self.info.update(state="stopped", error=f"gatbox-disk failed: {e!r}")
            raise
        finally:
            if scratch:
                try:
                    os.remove(scratch)
                except OSError:
                    pass
            if lock is not None:
                os.close(lock)
            self.log()

    @staticmethod
    def _read_back(node, pieces):
        """SHA-1 of every piece as the drive holds it now, in the order written (O_DIRECT on a block device, as hashed_read)."""
        h, direct = hashlib.sha1(), _is_block(node)
        fd = os.open(node, os.O_RDONLY | (os.O_DIRECT if direct else 0))
        try:
            buf = mmap.mmap(-1, CHUNK)
            view = memoryview(buf)
            try:
                for off, n, _ in pieces:
                    h.update(struct.pack("<QQ", off, n))
                    at = 0
                    while at < n:
                        got = os.preadv(fd, [view[:min(CHUNK, n - at)]], off + at)
                        if got <= 0:
                            raise Stop("the drive went away during the read-back", "it may be partly formatted: check it again")
                        h.update(view[:got])
                        at += got
            finally:
                view.release()
                buf.close()
        finally:
            os.close(fd)
        return h.hexdigest()

    def log(self):
        """One line per format, stopped or verified, in <store>/writes.jsonl beside the writes (op: format)."""
        if not store_mounted():
            return
        i = self.info
        lay = i.get("layout") or {}
        line = {"op": "format", "date": now_iso(), "epoch": round(time.time(), 3), "state": "verified" if i.get("verified") else "stopped",
                "device": i.get("device"), "target": i.get("target"), "fs": i.get("made") or lay.get("made"), "table": lay.get("table"),
                "label": i.get("label"), "bytes": i.get("bytes"), "ack": i.get("ack"), "armed": i.get("armed"),
                "contents": i.get("contents"), "has_image": i.get("has_image"), "written": bool(i.get("written")),
                "error": i.get("error"), "tool": "gatbox-disk"}
        with open(os.path.join(os.path.realpath(DISKS), "writes.jsonl"), "a") as f:
            f.write(json.dumps(line) + "\n")


