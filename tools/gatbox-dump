#!/usr/bin/env python3
"""gatbox-dump — read an EPROM on the XGecu T48, identify it against MAME, archive it under its machine.

    gatbox-dump --search 27C020                        the part names minipro knows for the T48 (pick one exactly)
    gatbox-dump -p TMS27C020@DIP32 -l EPR-15781C       read, identify, archive (machine: the current one)
    gatbox-dump -p PART -l LABEL -m SLUG [--ignore-id] [--keep-blank] [--yes] [--json]

The read, in order (M7 spec):
  1. The part is the exact minipro name. It is never auto-detected: the same chip exists under several names
     (27C020@DIP32 vs TMS27C020@DIP32 …) and minipro's chip-ID check is what catches a wrong pick.
  2. 27C1000 / 27C301: the non-JEDEC pinout warning, and a confirmation (--yes).
  3. minipro's pin-contact check (-z), if it supports it for the part ("Pin test is not supported." is fine).
  4. Two full reads, compared. Different = the chip isn't seated well: stop, reseat, try again.
  5. All 0xFF (blank, or no contact) and all 0x00 (no contact, dead chip) are flagged, and not archived unless
     --keep-blank.
  6. A chip-ID complaint stops the read and shows minipro's message (it usually names the right part). minipro's
     -y (ignore the ID) is passed only with --ignore-id, and the sidecar says so.
  7. SHA-1 + CRC32, then `mame -romident` → MATCH <set>/<rom> (every match listed) or NO MATCH.
  8. Archive: <roms>/<machine>/<label>_<sha1:8>.bin + .json sidecar. Never overwrites; a dump with the same SHA-1
     already in that machine's folder is reported as already archived.

Burning (2026-09-29, the owner's decision): gatbox-dump --burn IMAGE -p PART writes an image into a blank chip, the
part name typed to confirm (see class Burn: size check, blank check, write + minipro's verify, 2 read-backs). The
dashboard's BURN runs the same steps through gatbox-dump.service, armed by a hold on the Pi's own screen.

Environment: GATBOX_ROMS (archive, default /srv/gatbox/roms), GATBOX_API (gatbox-web, for the current machine and
the clock source; default http://127.0.0.1), GATBOX_MINIPRO / GATBOX_MAME (tests: stand-ins for the real programs).
"""
import argparse
import datetime
import glob
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.request
import zlib

MINIPRO = os.environ.get("GATBOX_MINIPRO", "minipro")
# Debian installs MAME as /usr/games/mame, and a systemd service's PATH has no /usr/games (2026-09-29: the first
# dashboard dump failed to identify with FileNotFoundError). So: its full path, found once.
MAME = (os.environ.get("GATBOX_MAME") or shutil.which("mame")
        or ("/usr/games/mame" if os.path.exists("/usr/games/mame") else "mame"))
ROMS = os.environ.get("GATBOX_ROMS", "/srv/gatbox/roms")
API = os.environ.get("GATBOX_API", "http://127.0.0.1")
PROGRAMMER = "T48"
LABEL = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,39}$")       # a chip label, safe as a file name
SLUG = re.compile(r"^[a-z0-9][a-z0-9-]{0,63}$")
NON_JEDEC = ("27C1000", "27C301")
ANSI = re.compile(r"\x1b\[[0-9;]*[A-Za-z]")


class Stop(Exception):
    """A reason to stop the dump, for the person at the T48 (and the dashboard's result card)."""
    def __init__(self, what, hint=""):
        super().__init__(what)
        self.what, self.hint = what, hint


def clean(text):
    """minipro's output without its progress-bar tricks (\\r redraws, ESC[K)."""
    lines = []
    for raw in ANSI.sub("", text).replace("\r", "\n").splitlines():
        line = raw.strip()
        if line and not re.match(r"^(Reading Code|Writing Code|Verifying Code)\.*\s*\d+%$", line):
            lines.append(line)
    return lines


def run(args, timeout=600):
    r = subprocess.run([MINIPRO] + args, capture_output=True, text=True, timeout=timeout)
    return r.returncode, clean(r.stdout + "\n" + r.stderr)


def parts(search=None):
    """Part names minipro knows for the T48 (a search, or the whole list)."""
    args = ["-q", PROGRAMMER] + (["-L", search] if search else ["-l"])
    _, out = run(args, timeout=60)
    skip = ("Found ", "Warning", "Device code", "Serial code", "Manufactured", "USB speed", "Supply voltage",
            "Expected", "minipro", "Supported programmers")
    return [l for l in out if not l.startswith(skip)]


def api(path):
    try:
        with urllib.request.urlopen(API + path, timeout=3) as r:
            return json.loads(r.read())
    except (OSError, ValueError):
        return None


class Dump:
    def __init__(self, part, label, machine, ignore_id=False, keep_blank=False, status=None, say=print):
        self.part, self.label, self.machine = part, label, machine
        self.ignore_id, self.keep_blank, self.status_file, self.say = ignore_id, keep_blank, status, say
        self.info = {"part": part, "label": label, "machine": machine, "steps": []}

    def step(self, name, detail="", progress=None):
        self.info["steps"].append({"step": name, "detail": detail, "at": round(time.time(), 3)})
        self.say(f"  {name}" + (f": {detail}" if detail else ""))
        if self.status_file:
            tmp = self.status_file + ".tmp"
            with open(tmp, "w") as f:
                json.dump(dict(self.info, state="running", step=name, detail=detail, progress=progress), f)
            os.replace(tmp, self.status_file)

    def read(self, path, n):
        args = ["-p", self.part, "-r", path] + (["-y"] if self.ignore_id else [])
        code, out = run(args)
        # 2026-09-28 (M2): "Invalid Chip ID: expected 0x8934, got 0x9732 (TMS27C020@DIP32)", and minipro exits non-zero
        bad_id = next((l for l in out if "chip id" in l.lower() and ("invalid" in l.lower() or "mismatch" in l.lower())), None)
        if bad_id and not self.ignore_id:
            raise self.id_stop(bad_id)
        if bad_id:
            self.info["id_check"] = f"ignored (--ignore-id): {bad_id}"
        if code != 0 or not os.path.exists(path):
            raise Stop(f"read {n} failed: " + " / ".join(out[-3:]), "check the chip is in the socket, notch toward the lever")
        return open(path, "rb").read()

    def id_stop(self, msg):
        """minipro refused the chip ID. What to do depends on why:
          * it names another part, "got 0x9732 (TMS27C020@DIP32)" (2026-09-28, the SegaSonic chip read as the generic
            27C020): use that part
          * a part in a package the socket doesn't take directly, "got 0xFEFF (unknown)" (2026-09-29: the same DIP chip
            read as TMS27C020@TSOP32): the DIP version of the same part, when minipro has one
          * no known ID from a DIP part: the chip isn't seated, or it's an old part with no ID. Only then read anyway."""
        m = re.search(r"\(([^)]+@[^)]+)\)", msg)
        if m:
            return Stop(f"minipro: {msg}", f"minipro thinks this chip is {m.group(1)}: dump again with -p {m.group(1)}")
        base, _, pkg = self.part.partition("@")
        if pkg and not pkg.upper().startswith("DIP"):
            dip = next((p for p in parts(base) if p.split("@")[0] == base and ("@" not in p or "@DIP" in p.upper())), None)
            return Stop(f"minipro: {msg}",
                        f"{self.part} is the {pkg} package, which needs a socket adapter; the T48's socket takes DIP chips "
                        "directly" + (f": dump again with -p {dip}" if dip else ": pick the DIP version of this part"))
        return Stop(f"minipro: {msg}",
                    "the chip didn't answer with a known ID: check it's seated (notch toward the lever, lever down) and the "
                    "part number printed on it. Only a part with no ID at all needs --ignore-id (it reads anyway, and the "
                    "sidecar says so)")

    def go(self):
        base = self.part.split("@")[0].upper()
        if any(x in base for x in NON_JEDEC) and not self.info.get("non_jedec_ok"):
            raise Stop(f"{self.part}: non-JEDEC pinout variants exist for this part (address lines A5/A7)",
                       "check the chip's datasheet against the board, then run again with --yes")
        code, out = run(["-p", self.part, "-z"], timeout=120)
        joined = " ".join(out)
        if "not supported" in joined.lower():
            self.info["pin_check"] = "not supported for this part"
        elif code != 0:
            raise Stop("pin check: " + " / ".join(out[-3:]), "reseat the chip (notch toward the lever), lever down")
        else:
            self.info["pin_check"] = "ok"
        self.step("pin check", self.info["pin_check"])
        with tempfile.TemporaryDirectory(prefix="gatbox-dump-") as tmp:
            self.step("read 1 of 2", progress=0.1)
            a = self.read(os.path.join(tmp, "a.bin"), 1)
            self.step("read 2 of 2", f"{len(a):,} bytes", progress=0.5)
            b = self.read(os.path.join(tmp, "b.bin"), 2)
        self.info.setdefault("id_check", "ok")
        if a != b:
            diff = sum(1 for x, y in zip(a, b) if x != y) + abs(len(a) - len(b))
            raise Stop(f"the two reads differ ({diff:,} bytes)", "reseat the chip and dump again: a bad contact reads differently each time")
        self.info.update(size=len(a), reads_compared=2, identical=True)
        blank = "all 0xFF (a blank chip, or no contact)" if a.count(0xFF) == len(a) else \
                "all 0x00 (no contact, or a dead chip)" if a.count(0) == len(a) else None
        self.info["blank"] = blank
        if blank:
            self.step("blank check", blank)
            if not self.keep_blank:
                raise Stop(f"the chip reads {blank}", "check the seating and the part; --keep-blank archives it anyway")
        sha1, crc = hashlib.sha1(a).hexdigest(), f"{zlib.crc32(a) & 0xFFFFFFFF:08x}"
        self.info.update(sha1=sha1, crc32=crc)
        self.step("identify", f"SHA-1 {sha1[:12]}… CRC32 {crc}", progress=0.8)
        self.info["romident"] = romident(a)
        return a

    def archive(self, data, roms):
        folder = os.path.join(roms, self.machine)
        os.makedirs(folder, exist_ok=True)
        for side in glob.glob(os.path.join(folder, f"*_{self.info['sha1'][:8]}.json")):
            try:
                old = json.load(open(side))
                if old.get("sha1") == self.info["sha1"]:
                    self.info["archived"] = {"path": side[:-5] + ".bin", "new": False}
                    self.step("archive", "already archived as " + os.path.basename(side[:-5]) + ".bin")
                    # the .bin is never rewritten; a sidecar whose identification never ran (MAME missing) gets this one
                    if (old.get("romident") or {}).get("match") is None and self.info["romident"].get("match") is not None:
                        old.update(romident=self.info["romident"],
                                   identified=datetime.datetime.now().astimezone().isoformat(timespec="seconds"))
                        tmp = side + ".tmp"
                        with open(tmp, "w") as f:
                            json.dump(old, f, indent=1)
                        os.replace(tmp, side)
                        self.step("archive", "identified now: the sidecar was updated")
                    return
            except (OSError, ValueError):
                continue
        path = os.path.join(folder, f"{self.label}_{self.info['sha1'][:8]}.bin")
        try:
            fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)       # never overwrite
        except FileExistsError:
            raise Stop(f"{path} already exists with different contents", "use another label")
        with open(fd, "wb") as f:
            f.write(data)
        self.info["archived"] = {"path": path, "new": True}
        with open(os.open(path[:-4] + ".json", os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644), "w") as f:
            json.dump(self.sidecar(), f, indent=1)
        self.step("archive", path)

    def sidecar(self):
        i = self.info
        return {"part": i["part"], "label": i["label"], "machine": i["machine"], "size": i["size"], "sha1": i["sha1"],
                "crc32": i["crc32"], "romident": i["romident"], "reads_compared": i["reads_compared"],
                "identical": i["identical"], "blank": i["blank"], "pin_check": i.get("pin_check"),
                "id_check": i.get("id_check"), "date": datetime.datetime.now().astimezone().isoformat(timespec="seconds"),
                "epoch": round(time.time(), 3), "clock": clock_source(), "programmer": programmer(),
                "tool": "gatbox-dump"}


def device(part):
    """minipro -d PART: the part's size in bytes and its programming voltage ("Memory: 262144 Bytes", "VPP programming
    voltage: 13V", minipro 0.7.4 on this Pi, 2026-09-29)."""
    _, out = run(["-q", PROGRAMMER, "-d", part], timeout=60)
    size = next((int(m.group(1)) for l in out for m in [re.match(r"Memory:\s*(\d+)\s*Bytes", l)] if m), None)
    vpp = next((l.split(":", 1)[1].strip() for l in out if l.lower().startswith("vpp programming voltage")), None)
    return size, vpp


class Burn(Dump):
    """Write an image into a blank EPROM on the T48, then prove it (2026-09-29, the owner's decision: a dashboard burn
    armed at the Pi; the terminal types the part name instead). In order, and every stop leaves the chip as it was:
      1. the image is a file; its size equals the part's (minipro -d), so minipro's own size check never matters
         (-s is never passed);
      2. the non-JEDEC confirmation; the pin check;
      3. blank check (minipro -b): a UV EPROM can only be programmed from erased (all 0xFF);
      4. the go-ahead: the dashboard's arm (a hold on the 7", unexpired, one per request) or the typed part name;
      5. minipro -w: it programs, then verifies against the image itself ("Verification OK");
      6. two reads, each compared with the image: VERIFIED only if both are identical to it.
    Every burn, stopped or verified, is a line in <roms>/burns.jsonl."""

    def __init__(self, image, part, machine, arm=None, confirm=None, status=None, say=print):
        super().__init__(part, "burn", machine, status=status, say=say)
        self.image, self.arm, self.confirm = image, arm, confirm
        self.info.update(op="burn", image=image)

    def check_blank(self):
        code, out = run(["-p", self.part, "-b"], timeout=300)
        bad_id = next((l for l in out if "chip id" in l.lower() and ("invalid" in l.lower() or "mismatch" in l.lower())), None)
        if bad_id:
            raise self.id_stop(bad_id)
        if code == 0 and any("is blank" in l for l in out):
            self.info["blank_ok"] = True
            self.step("blank check", "blank", progress=0.3)
            return
        self.info["blank_ok"] = False
        where = next((l for l in out if l.startswith("Verification failed")), " / ".join(out[-2:]))
        raise Stop(f"the chip is not blank ({where})", "UV-erase it first (a programmed EPROM can only go back to 0xFF "
                                                      "under UV light), or put in a blank one")

    def prepare(self):
        """Steps 1-3: everything short of writing. Used alone by the dashboard's BLANK CHECK."""
        if not os.path.isfile(self.image):
            raise Stop(f"no image file at {self.image}", "pick an image from the archive")
        data = open(self.image, "rb").read()
        size, vpp = device(self.part)
        self.info.update(size=len(data), sha1=hashlib.sha1(data).hexdigest(), vpp=vpp, part_size=size)
        if size != len(data):
            raise Stop(f"the image is {len(data):,} bytes, {self.part} holds {size:,}" if size else
                       f"minipro doesn't give {self.part}'s size", "pick the part whose size matches the image")
        self.step("image", f"{len(data):,} bytes · SHA-1 {self.info['sha1'][:12]}… · {self.part} · VPP {vpp}", progress=0.05)
        base = self.part.split("@")[0].upper()
        if any(x in base for x in NON_JEDEC) and not self.info.get("non_jedec_ok"):
            raise Stop(f"{self.part}: non-JEDEC pinout variants exist for this part (address lines A5/A7)",
                       "check the chip's datasheet against the board, then run again with --yes")
        code, out = run(["-p", self.part, "-z"], timeout=120)
        if "not supported" in " ".join(out).lower():
            self.info["pin_check"] = "not supported for this part"
        elif code != 0:
            raise Stop("pin check: " + " / ".join(out[-3:]), "reseat the chip (notch toward the lever), lever down")
        else:
            self.info["pin_check"] = "ok"
        self.step("pin check", self.info["pin_check"], progress=0.1)
        self.check_blank()
        return data

    def go(self):
        data = self.prepare()
        if self.arm is not None:                        # the dashboard: a hold on the Pi's own screen, 30 s to use it
            if not isinstance(self.arm, dict) or not isinstance(self.arm.get("until"), (int, float)) \
                    or self.arm["until"] < time.time():
                raise Stop("the arm expired before the burn started", "hold the button again")
            self.info["armed"] = {k: self.arm.get(k) for k in ("by", "at", "until")}
        elif self.confirm is None or not self.confirm(self):
            raise Stop("not burned: the part name didn't match", "type the exact part name to write the chip")
        self.step("writing", f"{self.part} ← {os.path.basename(self.image)}", progress=0.4)
        code, out = run(["-p", self.part, "-w", self.image], timeout=1200)
        bad_id = next((l for l in out if "chip id" in l.lower() and ("invalid" in l.lower() or "mismatch" in l.lower())), None)
        if bad_id:
            raise self.id_stop(bad_id)
        failed = next((l for l in out if l.startswith("Verification failed")), None)
        if code != 0 or failed or not any(l.startswith("Verification OK") for l in out):
            raise Stop("the write failed: " + (failed or " / ".join(out[-3:])),
                       "the chip may be partly programmed now: UV-erase it before trying again (or try another chip)")
        self.step("minipro's verify", "OK", progress=0.7)
        with tempfile.TemporaryDirectory(prefix="gatbox-burn-") as tmp:
            reads = []
            for n in (1, 2):
                self.step(f"read-back {n} of 2", progress=0.75 + 0.1 * n)
                reads.append(self.read(os.path.join(tmp, f"{n}.bin"), n))
        if any(r != data for r in reads):
            diff = [sum(1 for x, y in zip(r, data) if x != y) + abs(len(r) - len(data)) for r in reads]
            raise Stop(f"the read-backs don't match the image ({diff[0]:,} and {diff[1]:,} bytes differ)",
                       "reseat the chip and read it back (READ): if it still differs, the chip didn't take the program")
        self.info.update(verified=True, reads_compared=2)
        self.step("verified", "2 read-backs identical to the image", progress=1.0)

    def log(self):
        """One line per burn, stopped or verified, in <roms>/burns.jsonl (next to the archive it burns from)."""
        i = self.info
        line = {"date": datetime.datetime.now().astimezone().isoformat(timespec="seconds"), "epoch": round(time.time(), 3),
                "state": "verified" if i.get("verified") else "stopped", "image": self.image, "sha1": i.get("sha1"),
                "size": i.get("size"), "part": self.part, "vpp": i.get("vpp"), "machine": self.machine,
                "blank_ok": i.get("blank_ok"), "armed": i.get("armed"), "error": i.get("error"),
                "programmer": programmer(), "tool": "gatbox-dump --burn"}
        os.makedirs(ROMS, exist_ok=True)
        with open(os.path.join(ROMS, "burns.jsonl"), "a") as f:
            f.write(json.dumps(line) + "\n")


def romident(data):
    """mame -romident on the dump: every match, or none."""
    with tempfile.TemporaryDirectory(prefix="gatbox-romident-") as tmp:
        p = os.path.join(tmp, "dump.bin")
        with open(p, "wb") as f:
            f.write(data)
        try:
            r = subprocess.run([MAME, "-romident", p], capture_output=True, text=True, timeout=300, cwd=tmp)
        except (OSError, subprocess.SubprocessError) as e:
            return {"match": None, "matches": [], "error": repr(e)}
    matches = []
    for line in r.stdout.splitlines():               # "dump.bin = epr-15781c.ic18   sonic   SegaSonic … (Japan, rev. C)"
        if "=" not in line:
            continue
        rest = line.split("=", 1)[1].split(None, 2)
        if len(rest) >= 2:
            matches.append({"rom": rest[0], "set": rest[1], "description": rest[2].strip() if len(rest) > 2 else ""})
    if not matches and "NO MATCH" not in r.stdout:      # MAME ran but didn't answer: an error, not a NO MATCH
        return {"match": None, "matches": [],
                "error": ((r.stderr or r.stdout).strip()[-300:] or f"mame -romident exited {r.returncode}")}
    return {"match": bool(matches), "matches": matches}


def clock_source():
    s = api("/api/system")
    return ((s or {}).get("clock") or {}).get("source") or "unknown"


def programmer():
    code, out = run(["--version"], timeout=30)
    ver = next((l for l in out if l.startswith("minipro version")), None)
    found = next((l for l in out if l.startswith("Found ")), None)
    return {"minipro": ver.split()[2] if ver else None, "found": found}


def current_machine():
    m = api("/api/machine")
    return (m or {}).get("slug") or "unassigned"


def run_job(request, status):
    """The dashboard's dump (gatbox-dump.service, started by gatbox-dump.path when gatbox-web drops request.json in
    the spool). Claims the request (rename → running.json, so the path unit doesn't fire again), dumps, writes the
    outcome to the status file, removes running.json. A stopped dump is a normal outcome: exit 0."""
    running = os.path.join(os.path.dirname(request), "running.json")
    try:
        os.replace(request, running)
    except FileNotFoundError:
        return 0
    try:
        req = json.load(open(running))
        part, label, machine = str(req.get("part", "")), str(req.get("label", "")), str(req.get("machine") or "unassigned")
        d = Dump(part, label, machine, bool(req.get("ignore_id")), bool(req.get("keep_blank")), status,
                 say=lambda m: print("gatbox-dump:" + m, flush=True))
        d.info.update(non_jedec_ok=bool(req.get("yes")), job=req.get("id"), requested_at=req.get("at"))
        try:
            if not LABEL.match(label) or (machine != "unassigned" and not SLUG.match(machine)):
                raise Stop("bad request: label or machine", "gatbox-web validates these; this shouldn't happen")
            if part not in parts(part):
                raise Stop(f"{part!r} isn't a T48 part name in minipro")
            d.step("starting", f"{part} · {label} · {machine}", progress=0.02)
            data = d.go()
            d.archive(data, ROMS)
            d.info["state"] = "done"
        except Stop as s:
            d.info.update(state="stopped", error=s.what, hint=s.hint)
        except Exception as e:                      # a crash still ends as a result the dashboard can show
            d.info.update(state="stopped", error=f"gatbox-dump failed: {e!r}", hint="see journalctl -u gatbox-dump")
        d.info["finished_at"] = round(time.time(), 3)
        tmp = status + ".tmp"
        with open(tmp, "w") as f:
            json.dump(d.info, f)
        os.replace(tmp, status)
        print(f"gatbox-dump: {d.info['state']}: {d.info.get('error') or d.info.get('archived', {}).get('path')}", flush=True)
        return 0
    finally:
        try:
            os.remove(running)
        except FileNotFoundError:
            pass


def burn_cli(args, ap):
    """gatbox-dump --burn IMAGE -p PART: the terminal's burn. The go-ahead is the part name, typed after the blank
    check, once the image and the part are on screen."""
    if not args.part:
        ap.error("--burn needs -p PART (the exact minipro name printed on the blank chip)")
    if args.part not in parts(args.part):
        ap.error(f"{args.part!r} isn't a T48 part name in minipro")
    machine = args.machine or current_machine()

    def confirm(b):
        side = b.image[:-4] + ".json"
        ident = ""
        try:
            ri = json.load(open(side)).get("romident") or {}
            ident = "; ".join(f"{m['set']}/{m['rom']}" for m in ri.get("matches", [])) or ("NO MATCH" if ri.get("match") is False else "")
        except (OSError, ValueError):
            pass
        i = b.info
        print(f"\n  image  {b.image}\n         {i['size']:,} bytes · SHA-1 {i['sha1']}" + (f" · MAME {ident}" if ident else ""))
        print(f"  chip   {b.part} · {i['part_size']:,} bytes · VPP {i['vpp']} · blank")
        print(f"\nType the part name ({b.part}) to write this chip; anything else cancels: ", end="", flush=True)
        return sys.stdin.readline().strip() == b.part

    b = Burn(args.burn, args.part, machine, confirm=confirm)
    b.info["non_jedec_ok"] = args.yes
    print(f"gatbox-dump: burn {args.burn} into {args.part}")
    try:
        b.go()
    except Stop as s:
        b.info.update(state="stopped", error=s.what, hint=s.hint)
        b.log()
        print(f"\nSTOPPED: {s.what}" + (f"\n  → {s.hint}" if s.hint else ""))
        return 2
    b.info["state"] = "done"
    b.log()
    print(f"\nVERIFIED: {args.part} now holds {os.path.basename(args.burn)} (SHA-1 {b.info['sha1'][:12]}…): minipro's "
          "verify OK, 2 read-backs identical to the image")
    return 0


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--search", metavar="TEXT", help="list the T48 part names containing TEXT")
    ap.add_argument("-p", "--part", help="the exact minipro part name, e.g. TMS27C020@DIP32")
    ap.add_argument("-l", "--label", help="the chip's label, e.g. EPR-15781C (letters, digits . _ -)")
    ap.add_argument("-m", "--machine", help="roster slug (default: the current machine, else 'unassigned')")
    ap.add_argument("--ignore-id", action="store_true", help="read despite a chip-ID mismatch (minipro -y)")
    ap.add_argument("--keep-blank", action="store_true", help="archive an all-FF / all-00 read too")
    ap.add_argument("--yes", action="store_true", help="confirm a non-JEDEC part (27C1000, 27C301)")
    ap.add_argument("--json", action="store_true", help="print the result as JSON")
    ap.add_argument("--burn", metavar="IMAGE", help="write IMAGE into a blank chip (-p PART): blank check, the part "
                                                    "name typed to confirm, write, verify, 2 read-backs")
    ap.add_argument("--status", help=argparse.SUPPRESS)          # the dashboard job's progress file
    ap.add_argument("--job", help=argparse.SUPPRESS)             # the dashboard job's request file (gatbox-dump.service)
    args = ap.parse_args()
    # the archive is shared by the owner (terminal) and gatbox-dump.service (the dashboard), both in group
    # gatbox-dump, and /srv/gatbox/roms is setgid: a machine folder either one creates must stay writable by the other
    os.umask(0o002)

    if args.job:
        return run_job(args.job, args.status or os.path.join(os.path.dirname(args.job), "status.json"))

    if args.search is not None:
        found = parts(args.search)
        print("\n".join(found) if found else f"nothing matches {args.search!r}")
        return 0
    if args.burn:
        return burn_cli(args, ap)
    if not args.part or not args.label:
        ap.error("-p PART and -l LABEL are needed (or --search TEXT)")
    if not LABEL.match(args.label):
        ap.error("label: 1-40 of letters, digits, '.', '_', '-' (it becomes the file name)")
    machine = args.machine or current_machine()
    if machine != "unassigned" and not SLUG.match(machine):
        ap.error(f"machine: not a roster slug: {machine!r}")
    if args.part not in parts(args.part):
        near = parts(args.part.split("@")[0])[:12]
        ap.error(f"{args.part!r} isn't a T48 part name in minipro" + (": did you mean one of\n  " + "\n  ".join(near) if near else ""))

    say = (lambda *a: None) if args.json else print
    d = Dump(args.part, args.label, machine, args.ignore_id, args.keep_blank, args.status, say)
    d.info["non_jedec_ok"] = args.yes
    say(f"gatbox-dump: {args.part}, label {args.label}, machine {machine}")
    try:
        data = d.go()
        d.archive(data, ROMS)
    except Stop as s:
        d.info.update(state="stopped", error=s.what, hint=s.hint)
        if args.status:
            json.dump(d.info, open(args.status, "w"))
        if args.json:
            print(json.dumps(d.info))
        else:
            print(f"\nSTOPPED: {s.what}" + (f"\n  → {s.hint}" if s.hint else ""))
        return 2
    d.info["state"] = "done"
    if args.status:
        json.dump(d.info, open(args.status, "w"))
    if args.json:
        print(json.dumps(d.info))
        return 0
    ri, i = d.info["romident"], d.info
    print()
    if ri.get("match"):
        print("MATCH: " + "; ".join(f"{m['set']}/{m['rom']} ({m['description']})" for m in ri["matches"]))
    elif ri.get("match") is None:
        print(f"MAME couldn't run: {ri.get('error')}")
    else:
        print("NO MATCH: MAME doesn't know this ROM (a revision, a modified dump, or a bad read: compare with the board's sticker)")
    print(f"  {i['size']:,} bytes · SHA-1 {i['sha1']} · CRC32 {i['crc32']} · 2 reads identical")
    a = i["archived"]
    print(("  archived: " if a["new"] else "  already archived: ") + a["path"])
    return 0


if __name__ == "__main__":
    sys.exit(main())
